@page "/gruposedades"
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Parte Izquierda: Icono y Título -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary p-2 rounded-3 me-3 shadow-sm" style="background-color: #00338D !important;">
                        <i class="bi bi-people-fill text-white fs-5"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">
                            Gestión de Grupos de Edades
                        </h5>
                        <small class="text-muted">Administración de categorías y rangos de edades de los participantes</small>
                    </div>
                </div>

                <!-- Parte Derecha: Botón Agregar -->
                @if (idRol == 1 || idRol == 2)
                {
                    <button class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center"
                            @onclick="AbrirModalNuevo"
                            style="height: 36px; font-weight: 500; border-radius: 8px; background-color: #00338D !important;">
                        <i class="bi bi-plus-lg me-2"></i> Agregar Grupo de Edad
                    </button>
                }
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <PaginationComponent TItem="GrupoEdad" Items="Listgral" DefaultPageSize="10">
                    <ChildContentHeader>
                        <tr class="table-light border-bottom">
                            <th class="py-3 ps-3 text-secondary fw-bold" style="width: 8%; font-size: 0.85rem;">#</th>
                            <th class="py-3 text-secondary fw-bold" style="width: 27%; font-size: 0.85rem;">Nombre del Grupo</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 12%; font-size: 0.85rem;">Edad Mínima</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 12%; font-size: 0.85rem;">Edad Máxima</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 13%; font-size: 0.85rem;">Rango</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Fecha Creación</th>
                            <th class="py-3 text-secondary fw-bold text-center" style="width: 10%; font-size: 0.85rem;">Última Modificación</th>
                            <th class="py-3 pe-3 text-secondary fw-bold text-end" style="width: 8%; font-size: 0.85rem;">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        <tr class="align-middle border-bottom">
                            <td class="ps-3" style="width: 8%;"><span class="text-muted small">@p.Id</span></td>
                            <td class="text-start fw-medium text-dark" style="width: 27%;">@p.Nombre</td>
                            <td class="text-center fw-semibold text-dark" style="width: 12%;">@p.EdadMinima años</td>
                            <td class="text-center fw-semibold text-dark" style="width: 12%;">@p.EdadMaxima años</td>
                            <td class="text-center" style="width: 13%;">
                                <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                    @p.EdadMinima a @p.EdadMaxima años
                                </span>
                            </td>
                            <td class="text-center text-secondary small" style="width: 10%;">@p.CreateDate.ToShortDateString()</td>
                            <td class="text-center text-secondary small" style="width: 10%;">@p.UpdateDate.ToShortDateString()</td>
                            <td class="text-end pe-3" style="width: 8%;">
                                @if (idRol == 1 || idRol == 2)
                                {
                                    <button class="btn btn-link btn-sm text-primary p-0 me-2" @onclick="() => Editar(p)" title="Editar Grupo de Edad">
                                        <i class="bi bi-pencil-square fs-6"></i>
                                    </button>
                                    <button class="btn btn-link btn-sm text-danger p-0"
                                            @onclick="() => VerificarEliminar(p)" title="Eliminar Grupo de Edad">
                                        <i class="bi bi-trash3 fs-6"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    </ChildContentRow>
                </PaginationComponent>
            </div>
        </div>
    </div>

    @if (mostrarAlerta)
    {
        <div class="alerta-top shadow-sm animate__animated animate__fadeInDown">
            <div class="alert @claseAlerta d-flex align-items-center mb-0 px-4 py-2 border-0 shadow-lg" role="alert">
                <i class="bi @iconoAlerta me-2 fs-5"></i>
                <div class="fw-bold">
                    @mensajeAlerta
                </div>
            </div>
        </div>
    }
</div>

@if (cargando || guardando)
{
    <ModalCargando />
}

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header text-white" style="background-color: #00338D;">
                    <h5 class="modal-title fw-bold">
                        <i class="bi @(entidadEditando.Id == 0 ? "bi-plus-circle" : "bi-pencil-square") me-2"></i>
                        @(entidadEditando.Id == 0 ? "Agregar Grupo de Edad" : "Modificar Grupo de Edad")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal" disabled="@guardando"></button>
                </div>
                <div class="modal-body py-4 px-4">
                    <!-- Campo Nombre del Grupo -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Nombre del Grupo</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-tag"></i></span>
                            <input type="text" class="form-control" @bind="entidadEditando.Nombre"
                                   placeholder="Ej: Grupo 1, Infantil, Juvenil..." disabled="@guardando" />
                        </div>
                    </div>

                    <div class="row">
                        <!-- Campo Edad Mínima -->
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Edad Mínima</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-123"></i></span>
                                <input type="number" min="0" max="99" class="form-control" @bind="entidadEditando.EdadMinima"
                                       placeholder="Ej: 6" disabled="@guardando" />
                            </div>
                        </div>

                        <!-- Campo Edad Máxima -->
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Edad Máxima</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-123"></i></span>
                                <input type="number" min="0" max="99" class="form-control" @bind="entidadEditando.EdadMaxima"
                                       placeholder="Ej: 8" disabled="@guardando" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-4" @onclick="CerrarModal" disabled="@guardando">Cancelar</button>
                    <button type="button" class="btn btn-primary btn-sm px-4 shadow-sm" @onclick="GuardarCambios" disabled="@guardando" style="background-color: #00338D !important;">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <i class="bi bi-save me-1"></i>
                            <span>Guardar</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-body text-center py-4 px-4">
                    <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex p-3 mb-3">
                        <i class="bi bi-exclamation-octagon fs-2"></i>
                    </div>
                    <h5 class="fw-bold text-dark">¿Estás seguro?</h5>
                    <p class="text-secondary small mb-0">
                        Vas a eliminar el grupo de edad <strong>@entidadParaEliminar?.Nombre</strong> (@entidadParaEliminar?.EdadMinima a @entidadParaEliminar?.EdadMaxima años). Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center pb-4 gap-2">
                    <button class="btn btn-outline-secondary btn-sm px-4" @onclick="CerrarModalEliminar" disabled="@guardando">Cancelar</button>
                    <button class="btn btn-danger btn-sm px-4 shadow-sm" @onclick="ConfirmarEliminar" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Eliminando...</span>
                        }
                        else
                        {
                            <span>Eliminar</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<GrupoEdad> Listgral = new();
    private bool cargando = false;
    private bool guardando = false;
    private bool mostrarModal = false;
    private string mensajeAlerta = "";
    private bool mostrarAlerta = false;
    private string claseAlerta = "alert-success"; // Por defecto verde
    private string iconoAlerta = "bi-check-circle-fill";
    private bool mostrarModalEliminar = false;
    private GrupoEdad entidadEditando = default!;
    private GrupoEdad? entidadParaEliminar;
    private int idRol = 0;

    [Inject] private IGrupoEdad repository { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
            if (userrolaux.Success && !string.IsNullOrEmpty(userrolaux.Value))
            {
                if (int.TryParse(userrolaux.Value, out var rolVal))
                {
                    idRol = rolVal;
                }
            }
        }
        catch
        {
            // Silencioso en prerenderizado SSR: JSInterop (SessionStorage) requiere circuito interactivo
        }
        await LoadGenericDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
                if (userrolaux.Success && !string.IsNullOrEmpty(userrolaux.Value))
                {
                    if (int.TryParse(userrolaux.Value, out var rolVal) && idRol != rolVal)
                    {
                        idRol = rolVal;
                        StateHasChanged();
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error hidratando rol en AfterRender: {ex.Message}");
            }
        }
    }

    private async Task LoadGenericDataAsync()
    {
        cargando = true;
        try
        {
            Listgral = await repository.GetAllAsync() ?? new();
        }
        catch (Exception ex)
        {
            cargando = false;
            StateHasChanged();
            await MostrarNotificacion("No se pudieron cargar los datos " + ex.Message.ToString(), true);
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalNuevo()
    {
        entidadEditando = new();
        entidadEditando.CreateDate = DateTime.Now;
        entidadEditando.UpdateDate = DateTime.Now;

        mostrarModal = true;
    }

    private void Editar(GrupoEdad item)
    {
        entidadEditando = item;
        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task GuardarCambios()
    {
        if (guardando) return;
        guardando = true;
        StateHasChanged();

        try
        {
            // 1. Validación de Nombre del Grupo
            if (string.IsNullOrWhiteSpace(entidadEditando.Nombre))
            {
                await MostrarNotificacion("El nombre del grupo de edad es obligatorio.", true);
                return;
            }

            // 2. Validación de Rango de Edades
            if (entidadEditando.EdadMinima <= 0 || entidadEditando.EdadMaxima <= 0)
            {
                await MostrarNotificacion("Las edades mínima y máxima deben ser mayores a cero.", true);
                return;
            }

            if (entidadEditando.EdadMinima > entidadEditando.EdadMaxima)
            {
                await MostrarNotificacion("La edad mínima no puede ser mayor que la edad máxima.", true);
                return;
            }

            var useridaux = await SessionStorage.GetAsync<string>("UserId");
            if (!string.IsNullOrEmpty(useridaux.Value))
            {
                int userid = int.Parse(useridaux.Value);

                entidadEditando.UpdateDate = DateTime.Now;

                if (entidadEditando.Id == 0)
                {
                    entidadEditando.CreateDate = DateTime.Now;

                    await repository.AddAsync(entidadEditando);

                    mostrarModal = false;
                    await LoadGenericDataAsync();
                    await MostrarNotificacion($"Grupo de edad guardado correctamente");
                }
                else
                {
                    repository.Update(entidadEditando);

                    mostrarModal = false;
                    await LoadGenericDataAsync();
                    await MostrarNotificacion($"Grupo de edad actualizado correctamente");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            await MostrarNotificacion("Error al procesar la solicitud: " + ex.Message, true);
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private void VerificarEliminar(GrupoEdad item)
    {
        entidadParaEliminar = item;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar() => mostrarModalEliminar = false;

    private async Task ConfirmarEliminar()
    {
        if (entidadParaEliminar == null || guardando) return;
        guardando = true;
        StateHasChanged();

        try
        {
            repository.Delete(entidadParaEliminar.Id);
            mostrarModalEliminar = false;
            await LoadGenericDataAsync();
            await MostrarNotificacion($"Grupo de edad eliminado correctamente");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar: {ex.Message}");
            await MostrarNotificacion("No se pudo eliminar el registro", true);
        }
        finally
        {
            guardando = false;
            entidadParaEliminar = null;
            StateHasChanged();
        }
    }

    private async Task MostrarNotificacion(string mensaje, bool esError = false)
    {
        mensajeAlerta = mensaje;
        claseAlerta = esError ? "alert-danger" : "alert-success";
        iconoAlerta = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

        mostrarAlerta = true;
        StateHasChanged();

        await Task.Delay(4000);
        mostrarAlerta = false;
        StateHasChanged();
    }
}

