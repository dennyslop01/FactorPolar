    private List<string> fileNames = new List<string>();
    private string? mensajeAlerta;
    private bool mostrarAlerta = false;
    private bool cargando = false;

    [Inject] private IBeneficiario repobenefi { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        fileNames.Clear();
        if (!string.IsNullOrEmpty(rutaNota))
            fileNames.Add("Foto Boletin");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlertaimagen", 10);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        fileNames.Clear();
        if (!string.IsNullOrEmpty(rutaNota))
            fileNames.Add("Foto Boletin");
    }

    private async Task UploadFile(InputFileChangeEventArgs e) // Cambiado a UploadFile
    {
        cargando = true;
        var file = e.File;
        if (file == null) return;

        try
        {
            Stream streamToUpload;
            string fileName;
            string contentType = file.ContentType;

            // --- LÓGICA DE PROCESAMIENTO SEGÚN EL TIPO ---
            if (contentType.Contains("image"))
            {
                // Si es imagen, mantenemos tu lógica de redimensionado
                var resizedImage = await file.RequestImageFileAsync("image/jpeg", 800, 800);
                streamToUpload = resizedImage.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                fileName = $"{DateTime.Now:yyyyMMdd}_FotoBoletin.jpg";
                contentType = "image/jpeg";
            }
            else if (contentType == "application/pdf")
            {
                // Si es PDF, abrimos el stream directamente sin redimensionar
                streamToUpload = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // Aumentamos a 10MB para PDFs
                fileName = $"{DateTime.Now:yyyyMMdd}_Documento.pdf";
            }
            else
            {
                mensajeAlerta = "Formato no soportado. Solo imágenes y PDF.";
                mostrarAlerta = true;
                // 3. Forzamos el renderizado y esperamos un "ciclo" para que el DOM se actualice
                StateHasChanged();
                await Task.Delay(1); // Pequeña espera para asegurar que el DOM esté listo

                await jsRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlertaimagen", 8000);
                return;
            }

            // --- LÓGICA DE CARGA A GOOGLE DRIVE / GCS ---
            using (streamToUpload)
            {
                if (!string.IsNullOrEmpty(folderName))
                {
                    string folderId = await DriveService.CreateFolderAsync(folderName);
                    string fileIdResult = string.Empty;

                    Beneficiario? benefi = await repobenefi.GetByIdlAsync(beneficiarioId);

                    // Borrar archivo anterior si existe
                    if (benefi?.RutaNotas != null)
                    {
                        string oldFileId = benefi.RutaNotas.Split('/').Last();
                        await DriveService.DeleteFileAsync(oldFileId);
                    }

                    // Subida con el ContentType dinámico
                    fileIdResult = await DriveService.UploadFileAsync(streamToUpload, fileName, contentType, folderId);

                    if (benefi?.RutaNotas == null)
                        fileNames.Add("Foto Boletin"); //fileNames.Add(contentType.Contains("pdf") ? "Documento PDF" : "Foto Boletin");

                    await repobenefi.UpdateRutaNotaAsync(beneficiarioId, $"{folderId}/{fileIdResult}");
                }
            }

            mensajeAlerta = "Archivo subido correctamente.";
            mostrarAlerta = true;
            // 3. Forzamos el renderizado y esperamos un "ciclo" para que el DOM se actualice
            StateHasChanged();
            await Task.Delay(1); // Pequeña espera para asegurar que el DOM esté listo

            await jsRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlertaimagen", 8000);
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al procesar el archivo: {ex.Message}";
            mostrarAlerta = true;
            // 3. Forzamos el renderizado y esperamos un "ciclo" para que el DOM se actualice
            StateHasChanged();
            await Task.Delay(1); // Pequeña espera para asegurar que el DOM esté listo

            await jsRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlertaimagen", 8000);
        }
        cargando = false;
    }

