@rendermode InteractiveServer
@inject GoogleDriveService DriveService


<label for="fileInput"
       class="btn btn-primary @(esInvalido ? "disabled" : "")"
       style="cursor: @(esInvalido ? "not-allowed" : "pointer"); pointer-events: @(esInvalido ? "none" : "auto");">
    Cargar archivo PDF
</label>

<InputFile id="fileInput"
           OnChange="UploadFile"
           accept=".pdf"
           capture="camera"
           style="display:none;"
           disabled="@esInvalido" />
<br />
<br />

@if (fileNames.Any())
{
    <div>
        @foreach (var name in fileNames)
        {
            <strong>
                <label class="form-label">
                    <i class="bi bi-card-checklist"></i> @name &nbsp;&nbsp;
                    <button type="button"
                            class="btn btn-sm"
                            style="background-color: #f0f0f0; color: #333; border: 1px solid #ccc;"
                            @onclick="Eliminar">
                        X
                    </button>
                </label>
            </strong>
        }
    </div>
}
<br />
<br />
@if (mostrarAlerta)
{
    <div id="divAlertaimagen" class="alert alert-success alert-dismissible fade show toast-container" role="alert" style="display:none;">
        @mensajeAlerta
    </div>
}
else
{
    <div id="divAlertaimagen" class="alert alert-success alert-dismissible fade show toast-container" role="alert" style="display:none;">
    </div>
}

@if (cargando)
{
    <div class="modal fade show d-block modal-loading-center" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <!-- 'modal-dialog-centered' centra el modal verticalmente -->
        <div class="modal-dialog modal-dialog-centered">
            <!-- Ajustamos el ancho con 'mx-auto' y eliminamos bordes/fondo si solo quieres ver el spinner -->
            <div class="modal-content" style="background: transparent; border: none;">
                <div class="modal-body text-center">
                    <div class="modal-cargando">
                        <!-- Spinner de Bootstrap -->
                        <div class="spinner-border text-light" style="width: 3rem; height: 3rem;" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="text-light mt-2">Cargando...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {

    [Parameter] public string folderName { get; set; }
    [Parameter] public int beneficiarioId { get; set; }
    [Parameter] public string rutaNota { get; set; }
    [Parameter] public string nombreNota { get; set; }

    bool esInvalido = false;

    private string Message = "";
    private string ImageUrl; // Para mostrar un preview de la imagen
    private List<string> fileNames = new List<string>();
    private string? mensajeAlerta;
    private bool mostrarAlerta = false;
    private bool cargando = false;

    [Inject] private IBeneficiario repobenefi { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlertaimagen", 10);
            fileNames.Clear();
            if (nombreNota != null)
            {
                fileNames.Add(nombreNota);
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        fileNames.Clear();
        if (nombreNota != null)
        {
            fileNames.Add(nombreNota);
        }
        esInvalido = !string.IsNullOrEmpty(nombreNota);
        StateHasChanged();
    }

    private async Task UploadFile(InputFileChangeEventArgs e) // Cambiado a UploadFile
    {
        cargando = true;
        var file = e.File;
        if (file == null) return;

        try
        {
            Stream streamToUpload;
            string fileName;
            string contentType = file.ContentType;

            if (contentType == "application/pdf")
            {
                // Si es PDF, abrimos el stream directamente sin redimensionar
                streamToUpload = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // Aumentamos a 10MB para PDFs
                fileName = $"{DateTime.Now:yyyyMMdd}_Documento2.pdf";
            }
            else
            {
                mensajeAlerta = "Formato no soportado. Solo pdf.";/* imágenes y  */
                mostrarAlerta = true;
                cargando = false;
                // 3. Forzamos el renderizado y esperamos un "ciclo" para que el DOM se actualice
                StateHasChanged();
                await Task.Delay(1); // Pequeña espera para asegurar que el DOM esté listo

                await jsRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlertaimagen", 8000);
                return;
            }

            // --- LÓGICA DE CARGA A GOOGLE DRIVE / GCS ---
            using (streamToUpload)
            {
                if (!string.IsNullOrEmpty(folderName))
                {
                    string folderId = await DriveService.CreateFolderAsync(folderName);
                    string fileIdResult = string.Empty;

                    await DriveService.TrashPdfFilesInFolderAsync(folderId);

                    // Subida con el ContentType dinámico
                    fileIdResult = await DriveService.UploadFileAsync(streamToUpload, fileName, contentType, folderId);

                    fileNames.Add(file.Name); //fileNames.Add(contentType.Contains("pdf") ? "Documento PDF" : "Foto Boletin");
                    esInvalido = !string.IsNullOrEmpty(file.Name);
                    await repobenefi.UpdateRutaNotaAsync(beneficiarioId, $"{folderId}/{fileIdResult}", file.Name, 2);
                }
            }

            mensajeAlerta = "Archivo subido correctamente.";
            mostrarAlerta = true;
            cargando = false;
            // 3. Forzamos el renderizado y esperamos un "ciclo" para que el DOM se actualice
            StateHasChanged();
            await Task.Delay(1); // Pequeña espera para asegurar que el DOM esté listo

            await jsRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlertaimagen", 8000);
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al procesar el archivo: {ex.Message}";
            mostrarAlerta = true;
            cargando = false;
            // 3. Forzamos el renderizado y esperamos un "ciclo" para que el DOM se actualice
            StateHasChanged();
            await Task.Delay(1); // Pequeña espera para asegurar que el DOM esté listo

            await jsRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlertaimagen", 8000);
        }
    }

    private async Task Eliminar()
    {
        try
        {
            await repobenefi.UpdateRutaNotaAsync(beneficiarioId, null, null, 2);
            fileNames.Clear();
            nombreNota = null;
            esInvalido = !string.IsNullOrEmpty(nombreNota);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al procesar el archivo: {ex.Message}";
            mostrarAlerta = true;
            cargando = false;
            // 3. Forzamos el renderizado y esperamos un "ciclo" para que el DOM se actualice
            StateHasChanged();
            await Task.Delay(1); // Pequeña espera para asegurar que el DOM esté listo

            await jsRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlertaimagen", 8000);
        }
    }
}

