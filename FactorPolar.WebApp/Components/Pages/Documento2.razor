@page "/documento2/{Id}"
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveServer

<h5>Términos y Condiciones</h5>

<p>Lea detenidamente el documento hata el final para aceptar términos y condiciones</p>

@if (!string.IsNullOrEmpty(pdfBase64String))
{
    <iframe id="pdfFrame" style="width:100%; height:500px;" frameborder="0"></iframe>
}
else
{
    <p>Cargando PDF o error al encontrar el archivo...</p>
}
<br />
<br />

@if (!existeError)
{
    <div class="d-flex justify-content-center">
        @if (cargacompleta)
        {
            <button type="button" class="boton-postular" style="background-color:#33ccff" @onclick="Aceptar">
                Aceptar
            </button>
        }
        &nbsp; &nbsp; &nbsp; &nbsp;
        <button type="button" class="btn boton-postular btn-secondary me-2" @onclick="Rechazar">
            Rechazar
        </button>
    </div>
}
@if (mostrarAlerta)
{
    <div id="divAlerta" class="alert alert-success alert-dismissible fade show toast-container" role="alert">
        @mensajeAlerta
        <button type="button" class="btn-close" @onclick="() => mostrarAlerta = false"></button>
    </div>
}
@if (cargando)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); align-content:center">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="modal-cargando text-lg-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<br />
<br />

@code {
    [Parameter]
    public string Id { get; set; }
    private bool existeError = false;
    private bool cargando = false;
    private bool cargacompleta = false;
    private bool mostrarAlerta = false;
    private string mensajeAlerta = string.Empty;
    private Employee beneficiario = new();
    private string pdfBase64String;
    private string GetAssetPathWithHash() => "Documentos\\TyC Factor Polar.wdhxwnve93.pdf";
    private string? userEmail = string.Empty;

    [Inject] private IEmployee repository { get; set; } = null!;

    private async Task LoadAndConvertPdfToBase64Async()
    {
        var relativePathWithHash = GetAssetPathWithHash();

        // >>> ESTA ES LA MODIFICACIÓN CLAVE <<<
        // Elimina la parte del hash del nombre del archivo para encontrar el archivo físico real.
        // Asume que el hash está justo antes de la última extensión (.pdf)
        var physicalRelativePath = System.Text.RegularExpressions.Regex.Replace(
            relativePathWithHash,
            @"\.[a-zA-Z0-9]{8,}\.pdf$", // Busca un punto, 8+ caracteres alfanuméricos, y .pdf al final
            ".pdf"
        );

        // Construye la ruta física absoluta
        var physicalPath = Path.Combine(Env.WebRootPath, physicalRelativePath);

        // --- Depuración ---
        Console.WriteLine($"Ruta Web con hash: {relativePathWithHash}");
        Console.WriteLine($"Buscando ruta física: {physicalPath}");
        // ------------------

        if (System.IO.File.Exists(physicalPath))
        {
            // 1. Leer los bytes del archivo físico
            byte[] pdfBytes = await System.IO.File.ReadAllBytesAsync(physicalPath);

            // 2. Convertir el array de bytes a cadena Base64
            pdfBase64String = Convert.ToBase64String(pdfBytes);
        }
        else
        {
            Console.Error.WriteLine($"¡ERROR: Archivo físico no encontrado! Revise la ubicación o la expresión regular.");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity.IsAuthenticated)
            {
                var user = authState.User;
                userEmail = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value;
            }
        }
        catch (Exception ex)
        {
            // Manejo de errores (opcional)
            Console.WriteLine($"Error al cargar datos del usuario: {ex.Message}");
        }

        try
        {
            beneficiario = await repository.GetByIdAsync(int.Parse(Id));
            if (beneficiario != null)
            {
                await LoadAndConvertPdfToBase64Async();
            }
            else
            {
                mensajeAlerta = "Beneficiario no encontrado.";
                mostrarAlerta = true;
                existeError = true;
            }
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al cargar datos del beneficiario: {ex.Message}";
            existeError = true;
        }
        cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(pdfBase64String))
        {
            if (beneficiario != null)
            {
                if (beneficiario.Email.ToLower() != userEmail.ToLower())
                {
                    mensajeAlerta = $"Datos invalidos {beneficiario.Email} -- {userEmail}";
                    mostrarAlerta = true;
                }
                else
                {
                    cargacompleta = true;
                }
            }
            else
            {
                NavManager.NavigateTo($"/");
            }
            await jsRuntime.InvokeVoidAsync("loadPdfFromBase64", pdfBase64String);
            StateHasChanged();
        }
    }

    private async Task Aceptar()
    {
        try
        {
            await repository.UpdateAceptarTCAsync(int.Parse(Id));
            NavManager.NavigateTo($"/");
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al guardar los datos: {ex.Message}";
            mostrarAlerta = true;
        }
    }

    private Task Rechazar()
    {
        NavManager.NavigateTo($"/Saml2/Logout");
        return Task.CompletedTask;
    }
}

<script>
    document.addEventListener("keydown", function (e) {
        if (e.ctrlKey && (e.key === "p" || e.key === "P")) {
            e.preventDefault();
            alert("La impresión está deshabilitada.");
        }
    });
</script>