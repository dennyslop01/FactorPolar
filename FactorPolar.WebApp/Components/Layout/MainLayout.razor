@inherits LayoutComponentBase
@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

<MudLayout>
    <MudAppBar Elevation="5" Class="navbar-top" Style="background: linear-gradient(150deg, #00338D  0%, #00338D  100%);">
        <a href="/"><MudImage Src="LogoPolar.png" Alt="Empresas Polar" /></a>
        <MudText Typo="Typo.h4" Style="color: white;"></MudText>
        <MudSpacer />
        <MudText Typo="Typo.body1" Style="color: white; margin-right: 16px;">
            <AuthLinks />
        </MudText>
        <a href="/"><MudImage Src="FactorPolar.png" Alt="Empresas Polar" /></a>
    </MudAppBar>
    @* Needed for snackbars *@
    <MudSnackbarProvider />

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Style="margin-top: 3rem">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = false;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}
<style>
    body, .table, .input,
    .button, .icon {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 11px;
    }

    /* Estilo para el botón dentro de la tabla */
    .boton-postular {
        /* Aplica el mismo tamaño de fuente que el body/tabla */
        font-size: 11px;
        padding: 6px 10px;
        color: white;
        border: none;
        cursor: pointer;
        border-radius: 4px;
    }

    th, td {
        /* Alinear el contenido horizontalmente al centro */
        vertical-align: middle;
    }

    .modal-content {
        /* Define un ancho máximo para pantallas grandes */
        max-width: 500px;
        width: 90%; /* Ocupa el 90% del ancho disponible */
        background-color: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        /* Asegura que si el contenido es largo, se pueda hacer scroll */
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-content {
        /* Estilos para el cuadro del modal */
        background-color: white;
        padding: 20px;
        border-radius: 5px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        /* Opcional: define un ancho máximo */
        max-width: 500px;
        width: 90%;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 11px;
    }

    .navbar-top {
        height: 70px; /* Aumenta la altura de la barra */
        display: flex;
        align-items: center; /* Centra los elementos verticalmente */
        padding: 0 20px; /* Añade espacio a los lados */
    }
</style>

