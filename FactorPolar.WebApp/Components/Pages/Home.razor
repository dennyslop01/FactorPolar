@code {
    bool existe = false;
    bool existeAdminUser = false;
    private bool cargando = false;
    private bool isMobile;

    private Employee employee = new();
    private Usuario usuario = new();
    private List<Beneficiario>? beneficiario = new();
    private string? userEmail = "temporal.dennys.lopez@empresaspolar.com";
    private string? userName;
    private string? employeeName;
    private string? employeeNumber;
    private int? userrol = 0;

    [Inject] private IEmployee repoemployee { get; set; } = null!;
    [Inject] private IBeneficiario repobenefi { get; set; } = null!;
    [Inject] private IUsuario repousuario { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isMobile = await jsRuntime.InvokeAsync<bool>("isMobileDevice");
            if (!string.IsNullOrEmpty(userEmail))
            {
                await repoemployee.UpdateDispositivoAsync(userEmail, isMobile);
                StateHasChanged();
            }

            if(employee != null)
            {
                if (employee.FechaAceptarTC == null)
                {
                    if (employee.Id != 0)
                        NavManager.NavigateTo($"/documento2/{employee.Id}");
                }                
            }

            try
            {
                await LoadAdminDataAsync();
                var userrolaux = await SessionStorage.GetAsync<string>("UserRol");
                if (!string.IsNullOrEmpty(userrolaux.Value))
                {
                    userrol = int.Parse(userrolaux.Value);
                    StateHasChanged();
                }
                else
                {
                    if (!string.IsNullOrEmpty(userEmail))
                    {
                        if (usuario != null)
                        {
                            if (usuario.IdRol == 5)
                                NavManager.NavigateTo($"validaruser");
                            else
                            {
                                userrol = usuario.IdRol;
                                await SessionStorage.SetAsync("UserId", usuario.Id.ToString());
                                await SessionStorage.SetAsync("UserRol", userrol.ToString());
                                await SessionStorage.SetAsync("UserCedula", usuario.Cedula);
                                await SessionStorage.SetAsync("UserNombreCorto", usuario.NombreCorto);
                                StateHasChanged();
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al obtener el rol del usuario: {ex.Message}");
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            var authState = await authStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            userEmail = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value;
            string nombre = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.GivenName)?.Value;
            string apellido = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Surname)?.Value;

            userName = CultureInfo.CurrentCulture.TextInfo.ToTitleCase($"{nombre}, {apellido}".ToLower());

            await LoadUserDataAsync();
        }
        catch (Exception ex)
        {
            // Manejo de errores (opcional)
            Console.WriteLine($"Error al cargar datos del usuario: {ex.Message}");
        }
        cargando = false;
    }

    private async Task LoadUserDataAsync()
    {
        if (!string.IsNullOrEmpty(userEmail))
        {
            employee = await repoemployee.GetByEmailAsync(userEmail);
            if (employee != null)
            {
                if (employee.FechaAceptarTC != null)
                {
                    existe = true;
                    employeeName = CultureInfo.CurrentCulture.TextInfo.ToTitleCase(employee.FullName.ToLower());

                    string[] cadena = employeeName.Split(',');
                    if (cadena.Length > 1)
                        employeeName = $"{cadena[1]}, {cadena[0]}";

                    employeeNumber = employee.EmployeeNumber.ToString();

                    beneficiario = await repobenefi.GetByEmployeeEmailAsync(employee.Email);
                }
            }
        }
        await Task.CompletedTask;
    }

    private async Task LoadAdminDataAsync()
    {
        if (!string.IsNullOrEmpty(userEmail))
        {
            usuario = await repousuario.GetByEmailAsync(userEmail);
            if (usuario != null)
            {
                existeAdminUser = true;
            }
        }
        await Task.CompletedTask;
    }

    private void EditarEntidad(Beneficiario ben)
    {
        // if (ben.Documento1 == null)
        //     NavManager.NavigateTo($"/documento1/{ben.Id}");
        // else if (ben.Documento2 == null)
        //     NavManager.NavigateTo($"/documento2/{ben.Id}");
        // else if (ben.Documento3 == null)
        //     NavManager.NavigateTo($"/documento3/{ben.Id}");
        // else
        if(ben.EstadoPostulacion is not null)
            return;
        
        NavManager.NavigateTo($"/editar/{ben.Id}");
    }

    private void Salir()
    {
        NavManager.NavigateTo($"/Saml2/Logout");
    }
}