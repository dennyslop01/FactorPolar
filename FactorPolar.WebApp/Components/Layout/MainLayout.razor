@inherits LayoutComponentBase
@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

<MudLayout>
    <MudAppBar Elevation="5" Class="navbar-top" Style="background: linear-gradient(150deg, #00338D  0%, #00338D  100%);">

        <!-- Contenido de la izquierda -->
        <a href="/"><MudImage Src="LogoPolar.png" Alt="Empresas Polar" /></a>

        @if (userrol == 1)
        {
            <MudText Typo="Typo.body1" Style="color: white; margin-right: 16px;">
                <MudStack Row="true" Spacing="4" Class="ml-6">
                    <MudButton Variant="Variant.Text" Style="color: white;" href="@($"soportebeneficiarios")"><i class="bi bi-bezier2 m-1"></i> Soporte Beneficiarios</MudButton>
                </MudStack>
            </MudText>
            <MudText Typo="Typo.body1" Style="color: white; margin-right: 16px;">
                <MudStack Row="true" Spacing="4" Class="ml-6">
                    <MudButton Variant="Variant.Text" Style="color: white;" href="@($"clasificados")"><i class="bi bi-bezier2 m-1"></i> Clasificados</MudButton>
                </MudStack>
            </MudText>
            <MudText Typo="Typo.body1" Style="color: white; margin-right: 16px;">
                <MudStack Row="true" Spacing="4" Class="ml-6">
                    <MudButton Variant="Variant.Text" Style="color: white;" href="@($"rankingfinal")"><i class="bi bi-bezier2 m-1"></i> Ranking Final</MudButton>
                </MudStack>
            </MudText>
        }
        <!-- El Spacer empuja todo lo que sigue hacia la derecha -->
        <MudSpacer />
        <!-- Contenido de la derecha -->
        <MudText Typo="Typo.body1" Style="color: white; margin-right: 16px;">
            <!-- Esto parece contener enlaces de autenticación o texto -->
            <AuthLinks />
        </MudText>

        <!-- El logo de Factor Polar, pegado al final -->
        <a href="/"><MudImage Src="FactorPolar.png" Alt="Empresas Polar" />;&ensp;&ensp;</a>

    </MudAppBar>
    @* Needed for snackbars *@
    <MudSnackbarProvider />

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Style="margin-top: 3rem">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = false;
    int userrol = 5;
    private string? userEmail = "nadia.brito@empresaspolar.com";
    private Usuario usuario = new();
    [Inject] private IUsuario repousuario { get; set; } = null!;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await authStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            userEmail = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value;
            if(!string.IsNullOrEmpty(userEmail))
            {
                await LoadAdminDataAsync();
            }            
        }
        catch (Exception ex)
        {
            // Manejo de errores (opcional)
            Console.WriteLine($"Error al cargar datos del usuario: {ex.Message}");
        }
    }

    private async Task LoadAdminDataAsync()
    {
        if (!string.IsNullOrEmpty(userEmail))
        {
            usuario = await repousuario.GetByEmailAsync(userEmail);
            if (usuario != null)
            {
                userrol = (int)usuario.IdRol;
            }
        }
        await Task.CompletedTask;
    }
 }
<style>
    body, .table, .input,
    .button, .icon {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 11px;
    }

    html, body {
        margin: 0 !important;
        padding: 0 !important;
        overflow-x: hidden; /* Evita un scroll horizontal accidental */
        width: 100%;
    }

    /* Estilo para el botón dentro de la tabla */
    .boton-postular {
        /* Aplica el mismo tamaño de fuente que el body/tabla */
        font-size: 11px;
        padding: 6px 10px;
        color: white;
        border: none;
        cursor: pointer;
        border-radius: 4px;
        width: 80px;
        height: 30px;
    }

    .boton-postularConf {
        /* Aplica el mismo tamaño de fuente que el body/tabla */
        font-size: 11px;
        padding: 6px 10px;
        color: white;
        border: none;
        cursor: pointer;
        border-radius: 4px;
        height: 30px;
    }

    /* Estilo para el botón dentro de la tabla */
    .boton-cerrar {
        /* Aplica el mismo tamaño de fuente que el body/tabla */
        font-size: 11px;
        padding: 6px 10px;
        color: white;
        border: none;
        cursor: pointer;
        border-radius: 4px;
        width: 100px;
        height: 30px;
    }

    th, td {
        /* Alinear el contenido horizontalmente al centro */
        vertical-align: middle;
    }

    .modal-content {
        /* Define un ancho máximo para pantallas grandes */
        max-width: 500px;
        width: 90%; /* Ocupa el 90% del ancho disponible */
        background-color: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        /* Asegura que si el contenido es largo, se pueda hacer scroll */
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-content {
        /* Estilos para el cuadro del modal */
        background-color: white;
        padding: 20px;
        border-radius: 5px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        /* Opcional: define un ancho máximo */
        max-width: 500px;
        width: 90%;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 11px;
    }

    .navbar-top {
        width: 100vw !important;
        /* Ajusta la posición si es necesario */
        position: absolute;
        left: 0;
        right: 0;
    }
</style>

<script language="javascript">
    window.TimeoutHelper = {
        showAndHide: function (elementId, timeoutMs) {
            const divElement = document.getElementById(elementId);
            //console.log('Elemento encontrado:', divElement);
            if (divElement) {
                // Ya no necesitas 'display: block;' aquí si usas OnAfterRenderAsync
                // porque Blazor ya lo ha puesto visible condicionalmente.
                // Pero lo dejamos como seguro.
                divElement.style.display = 'block';

                setTimeout(function () {
                    divElement.style.display = 'none';
                }, timeoutMs);
            }
        }
    };

    window.isMobileDevice = () => {
        return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    };
</script>
