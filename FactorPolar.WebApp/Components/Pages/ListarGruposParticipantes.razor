                    </li>
                }
            </ul>

            <!-- Contenido de las Pestañas -->
            <div class="tab-content" id="talentEvalTabsContent">
                @for (int i = 1; i <= 4; i++)
                {
                    var currentEvalList = GetListEvalById(i);
                    <div class="tab-pane fade @(i == 1 ? "show active" : "")" id="paneleval-@i" role="tabpanel">
                        <div class="table-responsive">
                            <PaginationComponent TItem="Beneficiario" Items="currentEvalList" DefaultPageSize="10">
                                <ChildContentHeader>
                                    <tr class="table-light">
                                        @* <th class="border-0 text-uppercase small fw-bold">#</th> *@
                                        <th class="border-0 text-uppercase small fw-bold">No. Pers</th>
                                        <th class="border-0 text-uppercase small fw-bold">Nombre del Beneficiario</th>
                                        <th class="border-0 text-uppercase small fw-bold">Fecha Nacimiento</th>
                                        <th class="border-0 text-uppercase small fw-bold text-center">Edad</th>
                                        <th class="border-0 text-end">Acciones</th>
                                    </tr>
                                </ChildContentHeader>
                                <ChildContentRow Context="p">
                                    <tr class="align-middle">
                                        @* <td><span class="text-muted">@p.Id</span></td> *@
                                        <td class="fw-bold text-primary">@p.Employee.EmployeeNumber</td>
                                        <td>@CultureInfo.CurrentCulture.TextInfo.ToTitleCase(p.FullName.ToLower())</td>
                                        <td>@p.FechaNacimiento.ToShortDateString()</td>
                                        <td class="text-center">
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 rounded-pill">
                                                @p.Edad años
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-outline-warning btn-sm border-2 fw-bold px-3 rounded-pill me-2"
                                                    @onclick="() => VerDetalle(p)">
                                                <i class="bi bi-search me-1"></i> Detalle
                                            </button>
                                            @if (userRolgral == 1)
                                            {
                                                <button class="btn btn-outline-warning btn-sm border-2 fw-bold px-3 rounded-pill me-2"
                                                @onclick="() => VerEvaluaciones(p)">
                                                    <i class="bi bi-search me-1"></i> Evaluaciones
                                                </button>
                                            }
                                            @if(benefirubricauser.Where(x => x.Beneficiario.Id == p.Id && x.CloseDate == null &&
                                                                        x.Puntuacion == 0 && (x.RubricaEvaluacion.Id == 30 ||
                                                                        x.RubricaEvaluacion.Id == 31)).Count() >= 1)
                                            {
                                                <button class="btn btn-outline-danger btn-sm border-2 fw-bold px-3 rounded-pill me-2">
                                                    <i class="bi bi-x-circle me-1"></i></button>
                                            }
                                            else if (benefirubricauser.Where(x => x.Beneficiario.Id == p.Id && x.CloseDate == null &&
                                                                                x.Puntuacion == 1 && (x.RubricaEvaluacion.Id == 30 ||
                                                                                x.RubricaEvaluacion.Id == 31)).Count() >= 2)
                                            {
                                                <button class="btn btn-outline-warning btn-sm border-2 fw-bold px-3 rounded-pill me-2">
                                                    <i class="bi bi-exclamation-circle me-1"></i></button>
                                            }
                                            else if (benefirubricauser.Where(x => x.Beneficiario.Id == p.Id && x.CloseDate != null).Count() > 10)
                                            {
                                                <button class="btn btn-outline-success btn-sm border-2 fw-bold px-3 rounded-pill me-2">
                                                    <i class="bi bi-check2-circle me-1"></i></button>
                                            }
                                        </td>
                                    </tr>
                                </ChildContentRow>
                            </PaginationComponent>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (mostrarFormulario)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Generar CSV</h5>
                    <button type="button" class="btn-close" @onclick="Cancelar"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="entidadActual" OnValidSubmit="DescargarDatos">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Separador:</label>
                            <InputSelect class="form-select" @bind-Value="entidadActual.TipoSeparador">
                                <option value="-1">-- Seleccione uno --</option>
                                <option value="1">Coma</option>
                                <option value="2">Punto y Coma</option>
                                @* <option value="3">Tabulador</option> *@
                            </InputSelect>
                            <ValidationMessage For="@(() => entidadActual.TipoSeparador)" />
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn boton-primario me-2">
                                <i class="bi bi-save"></i> Generar
                            </button>
                            <button type="button" class="btn btn-danger" @onclick="Cancelar">
                                <i class="bi bi-times"></i> Cancelar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

