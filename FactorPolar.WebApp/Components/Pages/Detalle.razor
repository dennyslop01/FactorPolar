@page "/detalle/{Id}"
@using System.Globalization
@inject GoogleDriveService DriveService
@inject IJSRuntime jsRuntime
@rendermode InteractiveServer

<div class="container mt-4 pb-5">
    <!-- CABECERA PRINCIPAL -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white shadow-sm rounded-3">
        <div>
            <h6 class="text-muted mb-0">Detalle del Participante</h6>
            <h6 class="fw-bold text-primary mb-0">@datosbenefi</h6>
        </div>
    </div>
    @if (beneficiario != null)
    {
        <div class="row g-4">
            <!-- COLUMNA IZQUIERDA: DATOS ACADÉMICOS -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-primary text-white py-3">
                        <h6 class="mb-0"><i class="bi bi-mortarboard-fill me-2"></i>Información Académica</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-4">
                            <label class="text-muted small fw-bold text-uppercase d-block">Tipo de Institución</label>
                            <span>@(beneficiario.TipoInstitucionAux ?? beneficiario.TipoInstitucion)</span>
                        </div>

                        <div class="mb-4">
                            <label class="text-muted small fw-bold text-uppercase d-block">Institución Educativa</label>
                            <span>@(beneficiario.NombreInstitucionAux ?? beneficiario.NombreInstitucion)</span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-6">
                                <label class="text-muted small fw-bold text-uppercase d-block">RIF</label>
                                <span>@(beneficiario.RifInstitucionAux ?? beneficiario.RifInstitucion)</span>
                            </div>
                            <div class="col-6">
                                <label class="text-muted small fw-bold text-uppercase d-block">Promedio</label>
                                <span class="badge bg-success fs-6 rounded-pill px-3">
                                    @(beneficiario?.NivelEducativo == "PRIMARIA" ? (beneficiario.Promedio != null ? notaprimaria : "-") : beneficiario?.Promedio)
                                </span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="text-muted small fw-bold text-uppercase d-block">Nivel Educativo</label>
                            <span>@(beneficiario.NivelEducativoAux ?? beneficiario.NivelEducativo)</span>
                        </div>

                        <div class="mb-0">
                            <label class="text-muted small fw-bold text-uppercase d-block">Nivel Académico</label>
                            <span>
                                @if (beneficiario?.NivelEducativo == "PRIMARIA")
                                {
                                    if (beneficiario.Promedio != null)
                                    {
                                        @notaprimaria
                                    }
                                }
                                else
                                {
                                    @beneficiario?.Promedio
                                }
                            </span>
                        </div>
                        <div class="mb-4">
                        </div>

                        <div class="mb-4">
                            <button class="btn btn-outline-primary btn-sm rounded-pill px-4" @onclick="IniciarEvaluacion">
                                Iniciar Evaluación
                            </button>
                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-4" @onclick="Regresar">
                                <i class="bi bi-arrow-left-circle me-2"></i>Regresar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <!-- COLUMNA DERECHA: DOCUMENTOS Y MULTIMEDIA -->
            <div class="col-lg-8">
                <!-- Tarjeta PDF -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                        <h6 class="mb-0 fw-bold text-secondary"><i class="bi bi-file-earmark-pdf-fill me-2 text-danger"></i>Constancia de Notas</h6>
                    </div>
                    <div class="card-body p-0 bg-light">
                        <iframe id="pdfFrame" style="width:100%; height:450px; border:none;" frameborder="0"></iframe>
                    </div>
                </div>

                <!-- Tarjeta Video -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-bold text-secondary"><i class="bi bi-play-btn-fill me-2 text-warning"></i>Video del Talento</h6>
                    </div>
                    <div class="card-body p-0 bg-dark rounded-bottom overflow-hidden">
                        @if (!string.IsNullOrEmpty(videoSrc))
                        {
                            <video width="100%" height="450" controls style="outline: none;">
                                <source src="@videoSrc" type="video/mp4">
                                Tu navegador no soporta la reproducción de videos.
                            </video>
                        }
                        else
                        {
                            <div class="p-5 text-center text-white opacity-50">
                                <i class="bi bi-camera-video-off fs-1"></i>
                                <p class="mt-2">Cargando video o no disponible...</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<br />

@if (mostrarAlerta)
{
    <div id="divAlerta" class="alert alert-success alert-dismissible fade show toast-container" role="alert" style="display:none;">
        @mensajeAlerta
        <button type="button" class="btn-close" @onclick="() => mostrarAlerta = false"></button>
    </div>
}

@if (cargando)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); align-content:center">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="modal-cargando text-lg-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if(inieval)
{
    <br />
    <br />
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Criterio de entrada Fase I</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="entidadActual" OnValidSubmit="GuardarIniEvaluacion">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            @foreach (var item in rubricainicial)
                            {
                                <div class="mb-4">
                                    <label class="text-muted small fw-bold text-uppercase d-block">@item.Descripcion</label>
                                    @* <InputText oninput="this.value = this.value.replace(/[^0-9]/g, '');" class="form-control small" maxlength="15" @bind-Value="entidadActual.Cedula" placeholder="Cedula"></InputText> *@
                                </div>
                            }
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-4" >
                                Guardar
                            </button>&nbsp;&nbsp;&nbsp;
                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-4" @onclick="CerrarModal">
                                Cancelar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; }

    string datosbenefi = string.Empty;
    private Beneficiario? beneficiario = new();
    private const string notaprimaria = "A";

    private string? mensajeAlerta;
    private bool mostrarAlerta = false;
    private BenefiModel entidadActual = new();
    private bool cargando = false;
    private string folderName = string.Empty;
    private string imageSrc = null;
    private string videoSrc = null;
    private string urlSeleccionada = "";

    private string base64 = string.Empty;
    private string base64Video = string.Empty;

    private bool inieval = false;
    private List<RubricaEvaluacion> rubricainicial = new();

    [Inject] private IBeneficiario repobenefi { get; set; } = null!;
    [Inject] private IRubricaEvaluacion reporubrica { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            cargando = true;
            StateHasChanged();
            // Cargar el script de zoom después del primer renderizado
            await jsRuntime.InvokeVoidAsync("inicializarZoom");

            if (beneficiario != null)
            {
                string fileId = beneficiario.RutaNotas.Split('/').Last();

                base64 = await DriveService.GetFileAsync(fileId);
                await jsRuntime.InvokeVoidAsync("loadPdfFromBase64", base64);

                fileId = string.Empty;
                fileId = beneficiario.RutaVideo.Split('/').Last();
                base64Video = await DriveService.GetFileAsync(fileId);
                videoSrc = $"data:video/mp4;base64,{base64Video}";

                cargando = false;
                StateHasChanged();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await authStateProvider.GetAuthenticationStateAsync();
            if (!authState.User.Identity.IsAuthenticated)
                NavManager.NavigateTo($"/");
        }
        catch
        {
            NavManager.NavigateTo($"/");
        }

        cargando = true;
        try
        {
            beneficiario = await repobenefi.GetByIdlAsync(int.Parse(Id));
            if (beneficiario != null)
            {
                datosbenefi = CultureInfo.CurrentCulture.TextInfo.ToTitleCase($"{beneficiario.FullName}".ToLower());
                folderName = $"{beneficiario.CedulaIdentidad.Replace(".", "")}_{beneficiario.FechaNacimiento.ToString("yyyyMMdd")}_{beneficiario.Edad.ToString()}";
            }
        }
        catch (Exception ex)
        {
            datosbenefi = $"Error al cargar datos del beneficiario: {ex.Message}";
        }
        cargando = false;
    }

    private void Regresar()
    {
        NavManager.NavigateTo($"/");
    }

    private void AbrirModal(string url)
    {
        urlSeleccionada = url;
    }

    private void CerrarModal()
    {
        inieval = false;
    }

    private async Task IniciarEvaluacion()
    {
        rubricainicial = await reporubrica.GetByIdGrupoAsync(5);
        inieval = true;
    }

    private async Task GuardarIniEvaluacion()
    {
        
    }
}

<script>
    window.inicializarZoom = () => {
        const img = document.getElementById('imagenZoom');
        if (img) {
            img.addEventListener('click', function() {
                // Alternar la clase 'zoom-aplicado' al hacer clic
                this.classList.toggle('zoom-aplicado');
            });
        }
    };
</script>

<style>
    body {
        background-color: #f0f2f5;
    }

    .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .card-header {
        font-size: 0.95rem;
    }

    label {
        letter-spacing: 0.5px;
        margin-bottom: 2px;
    }

    /* Estilo por defecto */
    #imagenZoom {
        transition: transform 0.3s ease;
        transform-origin: center center;
    }

    /* Estilo cuando se aplica el zoom */
    #imagenZoom.zoom-aplicado {
        transform: scale(2.0); /* Aplica un zoom del 200% */
        cursor: zoom-out;
    }
</style>