<script>
    window.compressAndUploadToDrive = async (fileElement, accessToken) => {
        // 1. Obtener el objeto File desde el input de Blazor
        const file = fileElement;
        const url = "www.googleapis.com";

        // 2. Iniciar sesión de subida resumible
        const metadata = {
            name: file.name || "video_movil.mp4",
            mimeType: file.type || "video/mp4"
        };

        const initRes = await fetch(url, {
            method: "POST", // Este es el método correcto para INICIAR
            headers: {
                "Authorization": `Bearer ${accessToken}`,
                "Content-Type": "application/json; charset=UTF-8",
                "X-Upload-Content-Type": file.type || "video/mp4" // Agrega este encabezado
            },
            body: JSON.stringify(metadata)
        });

        if (!initRes.ok) {
            const errorDetail = await initRes.text(); // Esto leerá el error real de Google
            console.error("Detalle del error de Google:", errorDetail);
            throw new Error(`Google Drive API Error: ${initRes.status} - ${errorDetail}`);
        }
    
        const uploadUrl = initRes.headers.get("Location");

        // 3. Subida por fragmentos (Chunks) para evitar lentitud y errores de memoria
        const reader = file.stream().getReader();
        let uploadedBytes = 0;
        let finalResponse = null;

        while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            const isLastChunk = uploadedBytes + value.length === file.size;

            const res = await fetch(uploadUrl, {
                method: "PUT",
                headers: {
                    "Content-Range": `bytes ${uploadedBytes}-${uploadedBytes + value.length - 1}/${file.size}`
                },
                body: value
            });

            uploadedBytes += value.length;

            // El ID del archivo viene en la respuesta del último fragmento
            if (res.status === 200 || res.status === 201) {
                finalResponse = await res.json();
            }
        }

        return finalResponse ? finalResponse.id : null;
    };
</script>