        }
    }

    // Métodos que JS llama para actualizar la UI
    [JSInvokable]
    public void UpdateProgress(int percent)
    {
        progressPercent = percent;
        StateHasChanged();
    }

    [JSInvokable]
    public void UploadComplete(string fileId)
    {
        try
        {
            ActualizarDatos(fileId);
            mensajeAlerta = "Video subido correctamente.";
            TerminarProceso();
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al procesar el archivo: {ex.Message}";
            TerminarProceso();
        }
    }

    [JSInvokable]
    public void UploadFailed(string error)
    {
        mensajeAlerta = $"Error al procesar el archivo: {error}";
        TerminarProceso();
    }

    private async void ActualizarDatos(string fileId)
    {
        try
        {
            Beneficiario? benefi = await repobenefi.GetByIdlAsync(beneficiarioId);
            if (benefi?.RutaVideo == null)
                fileNames.Add("Video Talento");

            await repobenefi.UpdateRutaVideoAsync(beneficiarioId, $"{folderId}/{fileId}");
        }        
        catch (Exception ex)
        {
            throw new Exception($"Error al actualizar datos: {ex.Message}");
        }
    }

    private async void TerminarProceso()
    {
        mostrarAlerta = true;
        cargando = false;
        StateHasChanged();
        await Task.Delay(1);
        await jsRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlertavideo", 8000);
    }

    public void Dispose() => objRef?.Dispose();
}

