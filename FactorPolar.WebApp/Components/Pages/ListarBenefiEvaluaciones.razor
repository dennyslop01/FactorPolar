@using System.Globalization
@using System.Text
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center">
                <!-- Icono y Título agrupados -->
                <div class="bg-primary p-2 rounded-3 me-3 shadow-sm">
                    <i class="bi bi-people-fill text-white fs-5"></i>
                </div>

                <div class="me-auto">
                    <!-- Este div empuja todo lo demás a la derecha -->
                    <h6 class="mb-0 fw-bold text-dark">Evaluaciones Realizadas</h6>
                    <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                    </small>
                </div>

                <!-- Puntaje General centrado/derecha -->
                <div class="text-end me-4">
                    <!-- Badge más grande con fuente prominente -->
                    <span class="badge bg-secondary rounded-pill px-4 py-2 shadow-sm"
                          style="font-size: 1rem; font-weight: 600; min-width: 70px;">
                        @puntuacionGral
                    </span>
                </div>

                <!-- Botón al final -->
                <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" @onclick="Regresar">
                    <i class="bi bi-arrow-left-circle me-1"></i> Regresar
                </button>
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                @foreach (var usuario in entidadSegundaver.GroupBy(x => x.IdUsuario).Select(g => g.First()))
                {
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm h-100">                           
                            @if (benefirubricauser.Where(x => x.Beneficiario.Id == int.Parse(Id) && 
                                                            x.Usuario.Id == usuario.IdUsuario && 
                                                            x.DismissDate != null).Count() == 0)
                            {
                                <div class="card-header bg-primary text-white py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-0 fw-bold">@usuario.DescUsuario</h6>
                                            <small class="opacity-75">
                                                Factor Resultado: @entidadSegundaver.Where(x => x.IdUsuario == usuario.IdUsuario).Sum(y => y.Codigo)
                                            </small>
                                        </div>

                                        <!-- Botón Danger (Rojo) Redondeado y Pequeño -->
                                        <button class="btn btn-danger btn-sm rounded-pill px-3 shadow-sm border-0"
                                                style="font-size: 0.8rem; font-weight: 500;"
                                                @onclick="() => Desestimar(usuario.IdUsuario)">
                                            <i class="bi bi-x-circle me-1"></i> Desestimar
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="card-header bg-secondary text-white py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-0">@usuario.DescUsuario</h6>
                                            <label>Factor Resultado: @entidadSegundaver.Where(x => x.IdUsuario == usuario.IdUsuario).Sum(y => y.Codigo)</label>
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="card-body">
                                @foreach (var grupo in entidadSegundaver.Where(x => x.IdGrupo == 5 && x.IdUsuario == usuario.IdUsuario).GroupBy(x => x.IdGrupo).Select(g => g.First()))
                                {
                                    <div class="mt-3">
                                        <h6>@grupo.DescGrupo</h6>
                                    </div>

                                    @foreach (var item in entidadSegundaver.Where(x => x.IdGrupo == grupo.IdGrupo && x.IdUsuario == usuario.IdUsuario))
                                    {
                                        <div class="mb-4">
                                            <label class="text-muted small fw-bold text-uppercase d-block">@item.Descripcion</label>
                                            <label class="text-muted small fw-bold text-uppercase d-block">@item.Codigo</label>
                                        </div>
                                    }
                                    <hr />
                                }
                                @foreach (var grupo in entidadSegundaver.Where(z => z.IdGrupo != 5 && z.IdUsuario == usuario.IdUsuario).GroupBy(x => x.IdGrupo).Select(g => g.First()))
                                {
                                    <div class="mt-3">
                                        <h6>@grupo.DescGrupo</h6>
                                    </div>

                                    @foreach (var item in entidadSegundaver.Where(x => x.IdGrupo == grupo.IdGrupo && x.IdUsuario == usuario.IdUsuario))
                                    {
                                        <div class="mb-4">
                                            <label class="text-muted small fw-bold text-uppercase d-block">@item.Descripcion</label>
                                            <label class="text-muted small fw-bold text-uppercase d-block">@item.Codigo</label>
                                        </div>
                                    }
                                    <hr />
                                }
                            </div>                            
                        </div>
                    </div>
                }
            </div>                
        </div>
    </div>
</div>


@code {
    [Parameter]
    public string Id { get; set; }

    private decimal puntuacionGral = 0;

    private List<RubricaCompuestaUsuario> entidadSegundaver = new();
    private List<RubricaEvaluacion> rubricasegunda = new();
    private List<RubricaEvaluacion> rubricatodas = new();
    private List<BeneficiarioRubrica?> benefirubricauser = new();

    [Inject] private IRubricaEvaluacion reporubrica { get; set; } = null!;
    [Inject] private IBeneficiarioRubrica reporubbenefi { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            rubricatodas = await reporubrica.GetAllAsync();

            await LlenarEvaluaciones();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar evaluaciones: {ex.Message}");
        }
    }

    private async Task LlenarEvaluaciones()
    {
        benefirubricauser = await reporubbenefi.GetByIdBenefiAsync(int.Parse(Id));
        puntuacionGral = benefirubricauser.Where(x => x.DismissDate == null).Sum(x => x.FactorResultado);

        entidadSegundaver = new List<RubricaCompuestaUsuario>();

        foreach (var usuario in benefirubricauser.GroupBy(x => x.Usuario.Id).Select(g => g.First()))
        {
            for (int i = 1; i <= 5; i++)
            {
                rubricasegunda = rubricatodas.Where(x => x.GrupoEvaluacion.Id == i).ToList();
                foreach (var r in rubricasegunda)
                {
                    var existeEvaluacion = benefirubricauser.Where(x => x.RubricaEvaluacion.Id == r.Id && x.Beneficiario.Id == int.Parse(Id) && x.Usuario.Id == usuario.Usuario.Id);
                    if (existeEvaluacion == null || !existeEvaluacion.Any())
                    {
                        continue; // Si no hay evaluación para esta rúbrica, saltamos al siguiente
                    }

                    decimal puntuacion = benefirubricauser.Where(x => x.RubricaEvaluacion.Id == r.Id && x.Usuario.Id == usuario.Usuario.Id).Select(x => x.FactorResultado).FirstOrDefault();
                    string emailUsuario = benefirubricauser.Where(x => x.RubricaEvaluacion.Id == r.Id && x.Usuario.Id == usuario.Usuario.Id).Select(x => x.Usuario.Email).FirstOrDefault();
                    string nombUsuario = benefirubricauser.Where(x => x.RubricaEvaluacion.Id == r.Id && x.Usuario.Id == usuario.Usuario.Id).Select(x => x.Usuario.NombreCorto).FirstOrDefault();

                    if (!string.IsNullOrEmpty(nombUsuario))
                    {
                        emailUsuario += $" ({nombUsuario})";
                    }

                    var registro = new RubricaCompuestaUsuario
                    {
                        IdUsuario = usuario.Usuario.Id,
                        DescUsuario = emailUsuario,
                        IdRubrica = r.Id,
                        Descripcion = r.Descripcion,
                        IdGrupo = r.GrupoEvaluacion.Id,
                        DescGrupo = r.GrupoEvaluacion.NombreGrupo,
                        Codigo = puntuacion
                    };

                    entidadSegundaver.Add(registro);
                }
            }
        }
    }

    private async Task Desestimar(int userid)
    {
        try
        {
            var userrol = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrol.Value))
            {
                if (int.Parse(userrol.Value) == 1)
                {
                    bool confirmado = await jsRuntime.InvokeAsync<bool>("confirm", "¿Está seguro que desea desestimar esta evaluación?");
                    if (confirmado)
                    {
                        await reporubbenefi.DismissEvaluationAsync(userid, int.Parse(Id));
                        await LlenarEvaluaciones();
                        StateHasChanged();
                        NavManager.NavigateTo($"/verevaluaciones/{Id}");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al desestimar evaluaciones: {ex.Message}");
        }
    }

    private void Regresar()
    {
        NavManager.NavigateTo($"/");
    }
}
