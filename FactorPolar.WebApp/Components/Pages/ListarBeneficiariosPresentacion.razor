@using System.Globalization
@using System.Text
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <!-- Buscador Global por Nombre -->
    <div class="row mb-3">
        <div class="col-md-4 ms-auto">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control"
                       placeholder="Buscar por nombre..."
                       @oninput="FiltrarBusqueda" />
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center">
                <div class="bg-primary p-2 rounded-3 me-3">
                    <i class="bi bi-people-fill text-white fs-4"></i>
                </div>
                <h6 class="mb-0 fw-bold text-secondary">Talentos Clasificados - Presentación en Vivo</h6>
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-4">
                    <div>
                        <strong>Nro. de Registros:</strong> @Listgral.Count()
                    </div>
                </div>
            </div>
            <hr />
            <!-- Navegación de Pestañas Estilizada -->
            <ul class="nav nav-pills nav-fill mb-4 bg-light p-2 rounded-pill" id="talentTabs" role="tablist">
                @foreach (var grupo in GruposConfig)
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill @(grupo.Id == 1 ? "active" : "")"
                                id="tab-@grupo.Id" data-bs-toggle="tab" data-bs-target="#panel-@grupo.Id"
                                type="button" role="tab">
                            <span class="fw-semibold">@grupo.Nombre</span>
                            <small class="d-block opacity-75">@grupo.Rango</small>
                        </button>
                    </li>
                }
            </ul>

            <!-- Contenido de las Pestañas -->
            <div class="tab-content" id="talentTabsContent">
                @for (int i = 1; i <= 4; i++)
                {
                    var currentList = GetListById(i);
                    <div class="tab-pane fade @(i == 1 ? "show active" : "")" id="panel-@i" role="tabpanel">
                        <div class="table-responsive">
                            <PaginationComponent TItem="BeneficiarioEnVivo" Items="currentList" DefaultPageSize="10">
                                <ChildContentHeader>
                                    <tr class="table-light">
                                        @* <th class="border-0 text-uppercase small fw-bold">#</th> *@
                                        <th class="border-0 text-uppercase small fw-bold">No. Pers</th>
                                        <th class="border-0 text-uppercase small fw-bold">Nombre del Beneficiario</th>
                                        <th class="border-0 text-uppercase small fw-bold">Fecha Nacimiento</th>
                                        <th class="border-0 text-uppercase small fw-bold text-center">Edad</th>
                                        <th class="border-0 text-end">Acciones</th>
                                    </tr>
                                </ChildContentHeader>
                                <ChildContentRow Context="p">
                                    <tr class="align-middle">
                                        @* <td><span class="text-muted">@p.Id</span></td> *@
                                        <td class="fw-bold text-primary">@p.Employee.EmployeeNumber</td>
                                        <td>@CultureInfo.CurrentCulture.TextInfo.ToTitleCase(p.FullName.ToLower())</td>
                                        <td>@p.FechaNacimiento.ToShortDateString()</td>
                                        <td class="text-center">
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 rounded-pill">
                                                @p.Edad años
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            @if (p.Estado == 0)
                                            {
                                                <button class="btn btn-outline-warning btn-sm border-2 fw-bold px-3 rounded-pill"
                                                        @onclick="() => ActivarEnVivo(p)">
                                                    @* <i class="bi bi-search me-1"></i> *@ Activar
                                                </button>
                                                <button class="btn btn-outline-warning btn-sm border-2 fw-bold px-3 rounded-pill me-2"
                                                        @onclick="() => VerDetalle(p)">
                                                    <i class="bi bi-search me-1"></i> Detalle
                                                </button>
                                            }
                                            @if (p.Estado == 1)
                                            {
                                                <button class="btn btn-outline-warning btn-sm border-2 fw-bold px-3 rounded-pill me-2"
                                                        @onclick="() => VerEvaluaciones(p)">
                                                    @* <i class="bi bi-search me-1"></i> *@ Evaluaciones
                                                </button>
                                                <button class="btn btn-outline-secondary btn-sm border-2 fw-bold px-3 rounded-pill me-2"
                                                        @onclick="() => VerificarCompletar(p)">
                                                    @* <i class="bi bi-search me-1"></i> *@ Completar
                                                </button>
                                                <button class="btn btn-outline-danger btn-sm border-2 fw-bold px-3 rounded-pill me-2"
                                                        @onclick="() => VerificarCancelar(p)">
                                                    @* <i class="bi bi-search me-1"></i> *@ Cancelar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                </ChildContentRow>
                            </PaginationComponent>
                        </div>
                    </div>
                }
            </div>

            @if (mostrarCompletar)
            {
                <div class="modal-overlay">
                    <div class="modal-container">
                        <div class="modal-header">
                            <div class="icon-circle">
                                <i class="fas fa-check"></i> <!-- Usando FontAwesome o un SVG -->
                            </div>
                        </div>
                        <div class="modal-body">
                            <h2>¿Confirmar Presentación?</h2>
                            <p>Estás a punto de marcar esta presentación como <strong>Completada</strong>. Esta acción no se puede deshacer.</p>
                            <p>Evaluaciones Registradas: @nrovotantes</p>
                        </div>
                        <div class="modal-footer">
                            <button class="btn-cancel" @onclick="CerarModal">Volver</button>
                            <button class="btn-confirm" @onclick="() => CerrarEnVivo(beneficiarioEnVivo)">Sí, completar</button>
                        </div>
                    </div>
                </div>
            }

            @if(mostrarCancelar)
            {
                <div class="modal-overlay">
                    <!-- Añadimos 'modal-danger' para diferenciarlo del de confirmación -->
                    <div class="modal-container modal-danger">
                        <div class="modal-body">
                            <h2>¿Anular Presentación?</h2>
                            <p>Estás a punto de <strong>Cancelar</strong> esta participación. Esta acción marcará el registro como activo y perdera las evaluaciones realizadas.</p>
                        </div>
                        <div class="modal-footer">
                            <button class="btn-cancel" @onclick="CerarModal">No, volver</button>
                            <button class="btn-confirm" @onclick="() => CancelarEnVivo(beneficiarioEnVivo)">Sí, cancelar</button>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@code {
    private bool vistaGeneral = false;
    private bool mostrarCompletar = false;
    private bool mostrarCancelar = false;
    private int nrovotantes = 0;

    private List<BeneficiarioEnVivo> Listgral = new();
    private List<BeneficiarioEnVivo> ListgralBuscar = new();
    private BeneficiarioEnVivo beneficiarioEnVivo = new();

    private string searchTerm = "";
    [Inject] private IBeneficiario repobenefi { get; set; } = null!;
    [Inject] private IBeneficiarioClasificado reporubbenefi { get; set; } = null!;
    [Inject] private IBeneficiarioRubricaEnVivo reporubbenefivivo { get; set; } = null!;

    private List<BeneficiarioEnVivo> List1 = new();
    private List<BeneficiarioEnVivo> List2 = new();
    private List<BeneficiarioEnVivo> List3 = new();
    private List<BeneficiarioEnVivo> List4 = new();

    private List<GrupoInfo> GruposConfig = new()
    {
    new GrupoInfo { Id = 1, Nombre = "Grupo 1", Rango = "6 a 8 años" },
    new GrupoInfo { Id = 2, Nombre = "Grupo 2", Rango = "9 a 11 años" },
    new GrupoInfo { Id = 3, Nombre = "Grupo 3", Rango = "12 a 14 años" },
    new GrupoInfo { Id = 4, Nombre = "Grupo 4", Rango = "15 a 17 años" }
    };

    private List<BeneficiarioEnVivo> GetListById(int id) => id switch
    {
        1 => List1,
        2 => List2,
        3 => List3,
        4 => List4,
        _ => new List<BeneficiarioEnVivo>()
    };

    public class GrupoInfo { public int Id { get; set; } public string Nombre { get; set; } public string Rango { get; set; } }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadBenefiDataAsync();
        }
        catch (Exception ex)
        {
            // Manejo de errores (opcional)
            Console.WriteLine($"Error al cargar datos del los beneficiarios: {ex.Message}");
        }
    }

    private async Task LoadBenefiDataAsync()
    {
        var beneficiriosEval = await reporubbenefi.GetAlllAsync();

        Listgral.Clear();
        ListgralBuscar.Clear();

        var existeactiva = beneficiriosEval.Where(x => x.Estado == 1).ToList();
        if (existeactiva.Count() == 0)
        {
            foreach (var ben in beneficiriosEval.Where(x => x.Estado == 0))
            {
                var beneficiario = await repobenefi.GetByIdlAsync(ben.Beneficiario.Id);
                if (beneficiario != null)
                {
                    Listgral.Add(new BeneficiarioEnVivo
                        {
                            Id = beneficiario.Id,
                            FullName = beneficiario.FullName,
                            FechaNacimiento = beneficiario.FechaNacimiento,
                            Employee = beneficiario.Employee,
                            Edad = beneficiario.Edad,
                            Puntaje = ben.FactorResultado,
                            Categoria = ben.Categoria,
                            Estado = ben.Estado
                        });
                }
            }

            List1 = Listgral.Where(b => b.Edad >= 6 && b.Edad <= 8).ToList();
            List2 = Listgral.Where(b => b.Edad >= 9 && b.Edad <= 11).ToList();
            List3 = Listgral.Where(b => b.Edad >= 12 && b.Edad <= 14).ToList();
            List4 = Listgral.Where(b => b.Edad >= 15 && b.Edad <= 17).ToList();
        }
        else
        {
            foreach (var ben in existeactiva)
            {
                var beneficiario = await repobenefi.GetByIdlAsync(ben.Beneficiario.Id);
                if (beneficiario != null)
                {
                    Listgral.Add(new BeneficiarioEnVivo
                        {
                            Id = beneficiario.Id,
                            FullName = beneficiario.FullName,
                            FechaNacimiento = beneficiario.FechaNacimiento,
                            Employee = beneficiario.Employee,
                            Edad = beneficiario.Edad,
                            Puntaje = ben.FactorResultado,
                            Categoria = ben.Categoria,
                            Estado = ben.Estado
                        });
                }
            }

            List1 = Listgral.Where(b => b.Edad >= 6 && b.Edad <= 8).ToList();
            List2 = Listgral.Where(b => b.Edad >= 9 && b.Edad <= 11).ToList();
            List3 = Listgral.Where(b => b.Edad >= 12 && b.Edad <= 14).ToList();
            List4 = Listgral.Where(b => b.Edad >= 15 && b.Edad <= 17).ToList();
        }
        ListgralBuscar = Listgral;
        vistaGeneral = true;

        await Task.CompletedTask;
    }

    private async Task FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        if (string.IsNullOrEmpty(searchTerm))
        {
            await LoadBenefiDataAsync(); // Recargar datos completos si el término de búsqueda está vacío
        }
        else
        {
            var lowerSearchTerm = searchTerm.ToLower();
            Listgral = ListgralBuscar.Where(b => b.FullName.ToLower().Contains(lowerSearchTerm)).ToList();
        }
        StateHasChanged();
    }

    private async Task ActivarEnVivo(BeneficiarioEnVivo ben)
    {
        var userid = await SessionStorage.GetAsync<string>("UserId");
        if (!string.IsNullOrEmpty(userid.Value))
        {
            var userrol = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrol.Value))
            {
                if (userrol.Value == "1")
                {
                    await reporubbenefi.ActivarEnVivo(ben.Id);
                    await LoadBenefiDataAsync();
                }
            }
        }
    }

    private async Task CerrarEnVivo(BeneficiarioEnVivo ben)
    {
        var userid = await SessionStorage.GetAsync<string>("UserId");
        if (!string.IsNullOrEmpty(userid.Value))
        {
            var userrol = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrol.Value))
            {
                if (userrol.Value == "1")
                {
                    if (ben.Estado == 1)
                    {
                        await reporubbenefi.CerrarEnVivo(ben.Id);
                        await LoadBenefiDataAsync();
                        await CerarModal();
                    }
                }
            }
        }
    }

    private async Task CancelarEnVivo(BeneficiarioEnVivo benefi)
    {
        var userid = await SessionStorage.GetAsync<string>("UserId");
        if (!string.IsNullOrEmpty(userid.Value))
        {
            var userrol = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrol.Value))
            {
                if (userrol.Value == "1")
                {
                    await reporubbenefi.CancelarEnVivo(benefi.Id);
                    await LoadBenefiDataAsync();
                    await CerarModal();
                }
            }
        }
    }

    private async Task VerEvaluaciones(BeneficiarioEnVivo benefi)
    {
        var userid = await SessionStorage.GetAsync<string>("UserId");
        if (!string.IsNullOrEmpty(userid.Value))
        {
            var userrol = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrol.Value))
            {
                if (userrol.Value == "1")
                {
                    NavManager.NavigateTo($"/verevaluaciones2/{benefi.Id}");
                }
            }
        }
    }

    private async Task VerificarCompletar(BeneficiarioEnVivo benefi)
    {
        var userid = await SessionStorage.GetAsync<string>("UserId");
        if (!string.IsNullOrEmpty(userid.Value))
        {
            var userrol = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrol.Value))
            {
                if (userrol.Value == "1")
                {
                    if (benefi.Estado == 1)
                    {
                        var datosvotos = await reporubbenefivivo.GetByIdBenefiAsync(benefi.Id);
                        nrovotantes = datosvotos.GroupBy(x => x.Usuario.Id).Count();

                        beneficiarioEnVivo = benefi;
                        mostrarCompletar = true;
                    }
                }
            }
        }
    }

    private async Task VerificarCancelar(BeneficiarioEnVivo benefi)
    {
        var userid = await SessionStorage.GetAsync<string>("UserId");
        if (!string.IsNullOrEmpty(userid.Value))
        {
            var userrol = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrol.Value))
            {
                if (userrol.Value == "1")
                {
                    if (benefi.Estado == 1)
                    {
                        beneficiarioEnVivo = benefi; 
                        mostrarCancelar = true;
                    }
                }
            }
        }
    }
 
    private async Task CerarModal()
    {
        mostrarCompletar = false;
        mostrarCancelar = false;
    }

    private async Task VerDetalle(BeneficiarioEnVivo ben)
    {
        var userid = await SessionStorage.GetAsync<string>("UserId");
        if (!string.IsNullOrEmpty(userid.Value))
        {
            var userrol = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrol.Value))
            {
                if (userrol.Value == "1")
                {
                    NavManager.NavigateTo($"/detalle/{ben.Id}");
                }
            }
        }
    }
}

<style>
    /* Personalización para que las pestañas se vean más modernas */
    .nav-pills .nav-link {
        color: #6c757d;
        transition: all 0.3s ease;
    }

    .nav-pills .nav-link.active {
        background-color: #0d6efd !important;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.25);
    }

    .table-responsive {
        min-height: 400px;
    }

    .btn-outline-warning:hover {
        color: #000; /* Mejor contraste */
    }

</style>
