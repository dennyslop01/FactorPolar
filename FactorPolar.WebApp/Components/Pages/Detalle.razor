@if (vervaluarform)
{
    <br />
    <br />
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Rúbrica Evaluada</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        @foreach (var item in entidadActual)
                        {
                            <div class="mb-4">
                                <label class="text-muted small fw-bold text-uppercase d-block">@item.Descripcion</label>
                                <label class="text-muted small fw-bold text-uppercase d-block">@item.Codigo</label>
                            </div>
                        }
                    </div>
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-4" @onclick="CerrarModal">
                            Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}



@code {
    [Parameter]
    public string Id { get; set; }

    string datosbenefi = string.Empty;
    private Beneficiario? beneficiario = new();
    private const string notaprimaria = "A";

    private string? mensajeAlerta;
    private bool mostrarAlerta = false;

    private List<RubricaBasica> entidadActual = new();
    private EditContext? editContext;
    private ValidationMessageStore? mensajeStore;

    private bool cargando = false;
    private string folderName = string.Empty;
    private string imageSrc = null;
    private string videoSrc = null;
    private string urlSeleccionada = "";

    private string base64 = string.Empty;
    private string base64Video = string.Empty;

    private bool inieval = false;
    private List<RubricaEvaluacion> rubricainicial = new();
    private List<BeneficiarioRubrica?> benefirubrica = new();
    private List<BeneficiarioRubrica?> benefirubricauser = new();
    private bool sinevaluar = false;
    private bool rubricaevaluar = false;
    private bool compevaluar = false;
    private bool vervaluar = false;
    private bool vervaluarform = false;

    [Inject] private IBeneficiario repobenefi { get; set; } = null!;
    [Inject] private IRubricaEvaluacion reporubrica { get; set; } = null!;
    [Inject] private IBeneficiarioRubrica reporubbenefi { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            cargando = true;
            StateHasChanged();
            await jsRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 10);
            if (beneficiario != null)
            {
                string fileId = beneficiario.RutaNotas.Split('/').Last();

                base64 = await DriveService.GetFileAsync(fileId);
                await jsRuntime.InvokeVoidAsync("loadPdfFromBase64", base64);

                fileId = string.Empty;
                fileId = beneficiario.RutaVideo.Split('/').Last();
                base64Video = await DriveService.GetFileAsync(fileId);
                videoSrc = $"data:video/mp4;base64,{base64Video}";

                var userrol = await SessionStorage.GetAsync<string>("UserRol");
                if (!string.IsNullOrEmpty(userrol.Value))
                {
                    benefirubrica = await reporubbenefi.GetByIdBenefiAsync(int.Parse(Id));

                    var userid = await SessionStorage.GetAsync<string>("UserId");
                    if (!string.IsNullOrEmpty(userid.Value))
                    {
                        benefirubricauser = await reporubbenefi.GetByIdUserBenefilAsync(int.Parse(userid.Value), int.Parse(Id));

                        if (int.Parse(userrol.Value) == 1 && benefirubricauser.Count == 0)
                            sinevaluar = true;
                        else if (int.Parse(userrol.Value) != 1 && benefirubricauser.Count == 0)
                        {
                            int nrousurios = benefirubrica
                                .Where(x => x != null)
                                .Select(x => x!.Usuario.Id)
                                .Distinct()
                                .Count();

                            if (nrousurios < 4)
                                sinevaluar = true;
                        }
                        else if (benefirubricauser.Count > 0)
                        {
                            int existefalse = benefirubricauser.Where(x => x.Puntuacion == 0 && x.RubricaEvaluacion.GrupoEvaluacion.Id == 5).Count();
                            if (existefalse == 0)
                            {
                                rubricaevaluar = true;
                            }
                            else if (existefalse > 0)
                            {
                                vervaluar = true;
                            }
                        }
                    }
                }
                cargando = false;
                StateHasChanged();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await authStateProvider.GetAuthenticationStateAsync();
            if (!authState.User.Identity.IsAuthenticated)
                NavManager.NavigateTo($"/");
        }
        catch
        {
            NavManager.NavigateTo($"/");
        }

        cargando = true;
        try
        {
            editContext = new EditContext(entidadActual);
            mensajeStore = new ValidationMessageStore(editContext);
            editContext.OnFieldChanged += (s, e) => mensajeStore.Clear(e.FieldIdentifier);

            beneficiario = await repobenefi.GetByIdlAsync(int.Parse(Id));
            if (beneficiario != null)
            {
                datosbenefi = CultureInfo.CurrentCulture.TextInfo.ToTitleCase($"{beneficiario.FullName}".ToLower());
                folderName = $"{beneficiario.CedulaIdentidad.Replace(".", "")}_{beneficiario.FechaNacimiento.ToString("yyyyMMdd")}_{beneficiario.Edad.ToString()}";
            }
        }
        catch (Exception ex)
        {
            datosbenefi = $"Error al cargar datos del beneficiario: {ex.Message}";
        }
        cargando = false;
    }

    private void Regresar()
    {
        NavManager.NavigateTo($"/");
    }

    private void AbrirModal(string url)
    {
        urlSeleccionada = url;
    }

    private void CerrarModal()
    {
        inieval = false;
        vervaluarform = false;
    }

    private async Task IniciarEvaluacion()
    {
        rubricainicial = await reporubrica.GetByIdGrupoAsync(5);
        entidadActual = new List<RubricaBasica>();

        foreach(var r in rubricainicial)
        {
            var registro = new RubricaBasica
                {
                    IdRubrica = r.Id,
                    Descripcion = r.Descripcion,
                    Codigo = string.Empty // Esto obliga a seleccionar uno
                };

            entidadActual.Add(registro);
        }
        inieval = true;
    }

    private async Task GuardarIniEvaluacion()
    {
        try
        {
            mensajeStore?.Clear(); // Limpiar errores previos

            bool hayErrores = false;

            foreach (var item in entidadActual)
            {
                if (item.Codigo == null || string.IsNullOrEmpty(item.Codigo))
                {
                    // Asociamos el error específicamente a la propiedad Codigo de ESTE item
                    var fieldIdentifier = new FieldIdentifier(item, nameof(item.Codigo));
                    mensajeStore?.Add(fieldIdentifier, "Este campo es obligatorio.");
                    hayErrores = true;
                }
            }

            if (hayErrores)
            {
                editContext?.NotifyValidationStateChanged(); // Esto "refresca" la UI y muestra los mensajes
                return;
            }

            var userid = await SessionStorage.GetAsync<string>("UserId");
            if (!string.IsNullOrEmpty(userid.Value))
            {
                try
                {
                    foreach (var item in entidadActual)
                    {
                        await reporubbenefi.CreateAsync(int.Parse(userid.Value), item.IdRubrica, int.Parse(Id), int.Parse(item.Codigo));
                    }

                    inieval = false;
                    sinevaluar = false;

                    benefirubricauser = await reporubbenefi.GetByIdUserBenefilAsync(int.Parse(userid.Value), int.Parse(Id));
                    int existefalse = benefirubricauser.Where(x => x.Puntuacion == 0).Count();
                    if(existefalse == 0)
                    {
                        rubricaevaluar = true;
                    }
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    mensajeAlerta = $"Error al guardar la evaluación: {ex.Message}";
                    mostrarAlerta = true;
                }
            }
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al guardar la evaluación: {ex.Message}";
            mostrarAlerta = true;
        }
    }

    private void CompletarRubrica()
    {
        compevaluar = true;
    }

    private async Task GuardarCompEvaluacion()
    {
        try
        {
            // Aquí iría la lógica para guardar la evaluación completa, similar a lo que hicimos en GuardarIniEvaluacion
            // Por ejemplo, podrías actualizar los registros existentes con nuevas puntuaciones o comentarios.
            compevaluar = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al guardar al completar la evaluación: {ex.Message}";
            mostrarAlerta = true;
        }
    }

    private async Task VerEvaluacion()
    {
        var userid = await SessionStorage.GetAsync<string>("UserId");
        if (!string.IsNullOrEmpty(userid.Value))
        {
            benefirubricauser = await reporubbenefi.GetByIdUserBenefilAsync(int.Parse(userid.Value), int.Parse(Id));
            if (benefirubricauser.Count > 0)
            {
                rubricainicial = await reporubrica.GetByIdGrupoAsync(5);
                entidadActual = new List<RubricaBasica>();

                foreach (var r in rubricainicial)
                {
                    decimal puntuacion = benefirubricauser.Where(x => x.RubricaEvaluacion.Id == r.Id).Select(x => x.FactorResultado).FirstOrDefault();

                    var registro = new RubricaBasica
                        {
                            IdRubrica = r.Id,
                            Descripcion = r.Descripcion,
                            Codigo = puntuacion.ToString()
                        };

                    entidadActual.Add(registro);
                }
                vervaluarform = true;
            }
        }
    }
}

<script>
    window.inicializarZoom = () => {
        const img = document.getElementById('imagenZoom');
        if (img) {
            img.addEventListener('click', function() {
                // Alternar la clase 'zoom-aplicado' al hacer clic
                this.classList.toggle('zoom-aplicado');
            });
        }
    };
</script>

<style>
    body {
        background-color: #f0f2f5;
    }

    .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .card-header {
        font-size: 0.95rem;
    }

    label {
        letter-spacing: 0.5px;
        margin-bottom: 2px;
    }

    /* Estilo por defecto */
    #imagenZoom {
        transition: transform 0.3s ease;
        transform-origin: center center;
    }

    /* Estilo cuando se aplica el zoom */
    #imagenZoom.zoom-aplicado {
        transform: scale(2.0); /* Aplica un zoom del 200% */
        cursor: zoom-out;
    }
</style>