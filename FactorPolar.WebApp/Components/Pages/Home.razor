@page "/"
@rendermode InteractiveServer

@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized>
        <h6>Hola, Bienvenido!</h6>
        @if (existe)
        {
            <div class="row">
                <div class="col-2">
                    <strong><label class="form-label">Nombre:</label></strong>
                </div>
                <div class="col-8">
                    <label class="form-label">@employeeName</label>
                </div>
            </div>
            <div class="row">
                <div class="col-5">
                    <strong><label class="form-label">Número de Personal:</label></strong>
                </div>
                <div class="col-4">
                    <label class="form-label">@employeeNumber</label>
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-2">
                    <strong><label class="form-label">Beneficiarios:</label></strong>
                </div>
            </div>

            @if (beneficiario != null)
            {
                <table class="table">
                    <thead class="table">
                        <tr>
                            <th width="10%">#</th>
                            <th width="40">Nombre</th>
                            <th width="25%">Fecha Nacimiento</th>
                            <th width="15%">Edad</th>
                            <th width="10%"> </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (p, index) in beneficiario.Select((p, i) => (p, i + 1)))
                        {
                            <tr>
                                <td width="10%">@index</td>
                                <td width="40%">@p.FullName</td>
                                <td width="25%">@p.FechaNacimiento.ToShortDateString()</td>
                                <td width="15%">@p.Edad</td>
                                <td width="10%" class="justify-content-end">
                                    <button class="btn btn-success btn-sm me-1" @onclick="() => EditarEntidad(p)" title="Editar">
                                        <i class="bi bi-pencil"></i> Postular
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <br />
                <hr />
            }
        }

        @if(existeAdminUser)
        {
            <strong><label class="form-label">@userName</label></strong>
            <ListarGruposParticipantes />
            <br />
            <hr />
        }
        
        @if(!existe && !existeAdminUser)
        {
            <p>@userName</p>
            <p>El correo ingresado no tiene acceso a este beneficio, en caso de tener beneficiarios que aplique por favor comuniquese con Gestion Humana!</p>
        }
    </Authorized>
    <NotAuthorized>
        <h3>Hola, usted debe realizar login!</h3>
    </NotAuthorized>
</AuthorizeView>

@if (cargando)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); align-content:center">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="modal-cargando text-lg-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    bool existe = false;
    bool existeAdminUser = false;
    private bool cargando = false;

    private Employee employee = new();
    private Usuario usuario = new();
    private List<Beneficiario>? beneficiario = new();
    private string? userEmail;
    private string? userName;
    private string? employeeName;
    private string? employeeNumber;
    [Inject] private IEmployee repoemployee { get; set; } = null!;
    [Inject] private IBeneficiario repobenefi { get; set; } = null!;
    [Inject] private IUsuario repousuario { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            userEmail = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value;
            string nombre = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.GivenName)?.Value;
            string apellido = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Surname)?.Value;

            userName = $"{nombre}, {apellido}";

            await LoadUserDataAsync();
            await LoadAdminDataAsync();
        }
        catch (Exception ex)
        {
            // Manejo de errores (opcional)
            Console.WriteLine($"Error al cargar datos del usuario: {ex.Message}");
        }
        cargando = false;
    }

    private async Task LoadUserDataAsync()
    {
        if (!string.IsNullOrEmpty(userEmail))
        {
            usuario = await repousuario.GetByEmailAsync(userEmail);
            if (usuario != null)
            {
                existe = true;
            }
        }
        await Task.CompletedTask;
    }

    private async Task LoadAdminDataAsync()
    {
        if (!string.IsNullOrEmpty(userEmail))
        {
            employee = await repoemployee.GetByEmailAsync(userEmail);
            if (employee != null)
            {
                existeAdminUser = true;
                employeeName = employee.FullName;
                employeeNumber = employee.EmployeeNumber.ToString();

                beneficiario = await repobenefi.GetByEmployeeEmailAsync(employee.Email);
            }
        }
        await Task.CompletedTask;
    }

    private void EditarEntidad(Beneficiario ben)
    {
        if (ben.Documento1 == null)
            NavManager.NavigateTo($"/documento1/{ben.Id}");
        else if (ben.Documento2 == null)
            NavManager.NavigateTo($"/documento2/{ben.Id}");
        else if (ben.Documento3 == null)
            NavManager.NavigateTo($"/documento3/{ben.Id}");
        else
            NavManager.NavigateTo($"/editar/{ben.Id}");

    }
}