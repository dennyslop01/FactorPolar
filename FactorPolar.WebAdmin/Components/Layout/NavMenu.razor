@code {
    [Inject] private ICredentialRepository repository { get; set; } = null!;

    async Task LogoutAsync()
    {
        try
        {
            var token = await localStorageService.GetItemAsStringAsync(Constant.Key);
            if (!string.IsNullOrEmpty(token))
            {
                var tokenModel = JsonSerializer.Deserialize<Token>(token);
                await repository.DeleteCredential(tokenModel.AccessToken);
            }
            await localStorageService.DeleteItemAsync(Constant.Key);
        }
        catch { }
        NavManager.NavigateTo("/", true);
    }
}