@rendermode InteractiveServer

@inject IJSRuntime JS
@inject GoogleDriveService DriveService

@inject ISnackbar Snackbar // (Asumiendo MudBlazor)

<MudCard>
    <MudCardContent>
        <div class="d-flex justify-space-between align-center mb-2">
            <video id="cameraFeed" style="width: 100%; max-width: 500px; background: black;" muted></video>

            @if (isRecording)
            {
                @* Reloj de cuenta regresiva *@
                <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Timer">
                    @FormatTime(secondsLeft)
                </MudChip>
            }
        </div>

        @if (isUploading)
        {
            <MudProgressLinear Color="Color.Info" Indeterminate="true" Class="my-2" />
            <MudText Style="text-transform:capitalize;font-size: 11px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
                Subiendo video a Drive...
            </MudText>
        }
    </MudCardContent>
    <MudCardActions>
        @if (!isRecording)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Style="text-transform:capitalize;font-size: 11px;"
                       OnClick="StartVideo">
                <i class="bi bi-camera-video-fill mr-2"></i> Grabar Video (Máx 1 min)
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                       Style="text-transform:capitalize;font-size: 11px;"
                       OnClick="StopVideo">
                Detener Grabación
            </MudButton>
            <MudText Color="Color.Warning" Class="ml-5"
                     Style="text-transform:capitalize;font-size: 11px; font-weight: bold;">
                GRABANDO...
            </MudText>
        }
    </MudCardActions>
</MudCard>
<br />
<br />

@if (fileNames.Any())
{
    <div>
        @foreach (var name in fileNames)
        {
            <strong>
                <label class="form-label">
                    <i class="bi bi-camera-video"></i> @name
                </label>
            </strong>
        }
    </div>
}
<br />
<br />

@if (mostrarAlerta)
{
    <div id="divAlerta" class="alert alert-success alert-dismissible fade show toast-container" role="alert" style="display:none;">
        @mensajeAlerta
        <button type="button" class="btn-close" @onclick="() => mostrarAlerta = false"></button>
    </div>
}
else
{
    <div id="divAlerta" class="alert alert-success alert-dismissible fade show toast-container" role="alert" style="display:none;">
    </div>
}

@if (cargando)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); align-content:center">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="modal-cargando text-lg-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public string folderName { get; set; }
    [Parameter] public int beneficiarioId { get; set; }
    [Parameter] public string rutaVideo { get; set; }

    private List<string> fileNames = new List<string>();
    private bool isRecording = false;
    private bool isUploading = false;
    private DotNetObjectReference<CameraCapture>? objRef;

    private string? mensajeAlerta;
    private bool mostrarAlerta = false;
    private bool cargando = false;
    [Inject] private IBeneficiario repobenefi { get; set; } = null!;
    private int secondsLeft = 60;
    private Timer? _timer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            fileNames.Clear();
            if (!string.IsNullOrEmpty(rutaVideo))
                fileNames.Add("Video talento");

        }
    }

    protected override async Task OnParametersSetAsync()
    {
        fileNames.Clear();
        if (!string.IsNullOrEmpty(rutaVideo))
            fileNames.Add("Video talento");
    }

    private async Task StartVideo()
    {
        isRecording = true;
        // Llama al JS pasando el ID del video y la referencia a C#
        try
        {
            await JS.InvokeVoidAsync("cameraFunctions.startRecording", "cameraFeed", objRef);
            isRecording = true;
            secondsLeft = 60; // Reiniciar a 1 minuto

            // Iniciar el temporizador
            _timer = new Timer(1000);
            _timer.Elapsed += OnTimerElapsed;
            _timer.AutoReset = true;
            _timer.Enabled = true;
        }
        catch
        {
            ResetToInitialState();
        }
    }

    private async Task StopVideo()
    {
        StopTimer();
        await JS.InvokeVoidAsync("cameraFunctions.stopRecording");
        // El estado isRecording cambiará cuando el JS nos devuelva el video
        await Task.Delay(2000);
    }

    [JSInvokable]
    public void NotifyTimeLimit()
    {
        Snackbar.Add("Tiempo límite alcanzado (1 min). Procesando video...", Severity.Info);
    }

    [JSInvokable]
    public async Task NotifyVideoReady()
    {
        cargando = true;
        isRecording = false;
        isUploading = true;
        StateHasChanged();

        try
        {
            // 2. PEDIMOS EL STREAM A JS (Aquí está la magia de .NET Core)
            // Esto usa una referencia de stream, no carga todo en memoria RAM de golpe
            var streamRef = await JS.InvokeAsync<IJSStreamReference>("cameraFunctions.getVideoStream");

            // Límite de seguridad para el stream (ej. 100MB)
            using var stream = await streamRef.OpenReadStreamAsync(maxAllowedSize: 100 * 1024 * 1024);

            string fileName = $"{DateTime.Now:yyyyMMdd}_Video.webm";

            string folderId = await DriveService.CreateFolderAsync(folderName);
            string fileIdResult = string.Empty;

            Beneficiario? benefi = await repobenefi.GetByIdlAsync(beneficiarioId);
            // Borrar archivo anterior si existe
            if (benefi?.RutaVideo != null)
            {
                string oldFileId = benefi.RutaVideo.Split('/').Last();
                await DriveService.DeleteFileAsync(oldFileId);
            }

            // SUBIR A DRIVE
            // Nota: Aquí podrías pasar un FolderId si creaste una carpeta para el niño
            fileIdResult = await DriveService.UploadFileAsync(stream, fileName, "video/webm", folderId);

            if (benefi?.RutaNotas == null)
                fileNames.Add("Video Talento");

            await repobenefi.UpdateRutaVideoAsync(beneficiarioId, $"{folderId}/{fileIdResult}", "errorimage");

            Snackbar.Add($"Video guardado en Drive correctamente.", Severity.Success);cargando = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al subir: {ex.Message}", Severity.Error);
        }
        finally
        {
            cargando = false;
            isUploading = false;
            StateHasChanged();
        }
        
    }

    private void ResetToInitialState()
    {
        isRecording = false;
        isUploading = false;
        cargando = false;
        mostrarAlerta = false;
        mensajeAlerta = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        StopTimer();
        objRef?.Dispose();
    }

    private void OnTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        if (secondsLeft > 0)
        {
            secondsLeft--;
            InvokeAsync(StateHasChanged); // Forzar actualización de la UI
        }
        else
        {
            _ = StopVideo(); // Detener automáticamente al llegar a cero
        }
    }

    private string FormatTime(int totalSeconds)
    {
        return $"00:{totalSeconds:D2}";
    }

    private void StopTimer()
    {
        if (_timer != null)
        {
            _timer.Stop();
            _timer.Dispose();
            _timer = null;
        }
    }
}