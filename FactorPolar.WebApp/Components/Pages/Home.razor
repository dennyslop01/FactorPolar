@page "/"
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized>
        <h3>Hola, Bienvenido!</h3>
        <p>ID: @context.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)!.Value</p>
    </Authorized>
    <NotAuthorized>
        <h3>Hola, usted debe realizar login!</h3>
    </NotAuthorized>
</AuthorizeView>