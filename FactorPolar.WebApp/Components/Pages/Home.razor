@page "/"
@using System.Globalization
@rendermode InteractiveServer

@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized>
        <h6>Bienvenido</h6>
        @if (existe)
        {
            <div class="row">
                <div class="col-4">
                    <strong><label class="form-label">Nombre y Apellido:</label></strong>
                </div>
                <div class="col-7">
                    <label class="form-label">@employeeName</label>
                </div>
            </div>
            <div class="row">
                <div class="col-4">
            <strong><label class="form-label">Número de cédula:</label></strong>
                </div>
                <div class="col-7">
                    <label class="form-label">@employeeNumber</label>
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-5">
                    <strong><label class="form-label">Hijos a postular:</label></strong>
                </div>
            </div>

            @if (beneficiario != null)
            {
                <table class="table" id="mitabla">
                    <thead class="table">
                        <tr>
                            @* <th width="10%">#</th> *@
                            <th width="40">Nombre y Apellido</th>
                            <th width="25%">Fecha de Nacimiento</th>
                            <th width="15%">Edad</th>
                            <th width="10%"> </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (p, index) in beneficiario.Select((p, i) => (p, i + 1)))
                        {
                            <tr>
                                @* <td width="10%">@index</td> *@
                                <td width="40%">@CultureInfo.CurrentCulture.TextInfo.ToTitleCase(p.FullName.ToLower())</td>
                                <td width="25%">@p.FechaNacimiento.ToShortDateString()</td>
                                <td width="15%">@p.Edad</td>
                                <td width="10%" class="justify-content-end">
                                    @try
                                    {
                                        @if (string.IsNullOrEmpty(p.Promedio.ToString()) &&
                                            string.IsNullOrEmpty(p.RutaNotas.ToString()) &&
                                            string.IsNullOrEmpty(p.RutaVideo.ToString()))
                                        {
                                            <button class="boton-postular" style="background-color:#33ccff" @onclick="() => EditarEntidad(p)" title="Editar">
                                                @* <i class="bi bi-pencil"></i>&nbsp; *@Postular
                                            </button>
                                        }
                                        else
                                        {
                                            if (string.IsNullOrEmpty(p.EstadoPostulacion.ToString()))
                                            {
                                                <button class="boton-postular" style="background-color:#f53f5b" @onclick="() => EditarEntidad(p)" title="Editar">
                                                    @* <i class="bi bi-pencil"></i>&nbsp; *@Editar
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="boton-postular" style="background-color:#ffa100" @onclick="() => EditarEntidad(p)" title="Editar">
                                                    @* <i class="bi bi-pencil"></i>&nbsp; *@Postulado
                                                </button>
                                            }
                                        }
                                    }
                                    catch (Exception ex)
                                    {
                                        <button class="boton-postular" style="background-color:#33ccff" @onclick="() => EditarEntidad(p)" title="Editar">
                                            @* <i class="bi bi-pencil"></i>&nbsp; *@Postular
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <hr />
            }
        }

        <div class="d-flex justify-content-start">
            <a class="nav-link" title="Términos y Condiciones" href="documento1">
                Términos y Condiciones
            </a>
        </div>
        <div class="d-flex justify-content-end">
            <button class="boton-cerrar btn-secondary me-1" title="Salir" @onclick="Salir">
                Cerrar sesión
            </button>
        </div>

        @if(existeAdminUser)
        {
            <strong><label class="form-label">@userName</label></strong>
            <ListarGruposParticipantes />
            <br />
            <hr />
        }
        
        @if(!existe && !existeAdminUser)
        {
            <p>@userName</p>
            <p>Si no visualiza sus datos, por favor contacte al equipo de Gestión de Gente de su localidad</p>
        }
    </Authorized>
    <NotAuthorized>
        <div class="row">
            <div class="col-11">
                <h6>
                    ¡Bienvenido a la plataforma de Factor Polar! El espacio donde la excelencia, la innovación y la creatividad se unen para impulsar a tu hijo a alcanzar su más alto potencial.
                </h6>
            </div>
            <div class="col-11">
                <h6>Indica tu correo corporativo: <a class="btn-link" href="/Saml2/Login">Aquí</a></h6>
            </div>
            <div class="col-11">
                <h7>Si no visualiza sus datos, por favor contacte al equipo de Gestión de Gente de su localidad</h7>
            </div>
            <div class="col-11">
                <br />
            </div>
            <div class="col-11">
                <MudContainer>
                    <MudStack Row="true" Spacing="10" Justify="Justify.Center" AlignItems="AlignItems.Center">
                        <MudImage Src="Imagen Factor Polar.png" Class="img-responsive-half" />
                    </MudStack>
                </MudContainer>
            </div>
        </div>
    </NotAuthorized>
 </AuthorizeView>

@if (cargando)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); align-content:center">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="modal-cargando text-lg-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


@code {
    bool existe = false;
    bool existeAdminUser = false;
    private bool cargando = false;
    private bool isMobile;

    private Employee employee = new();
    private Usuario usuario = new();
    private List<Beneficiario>? beneficiario = new();
    private string? userEmail = "temporal.dennys.lopez@empresaspolar.com";
    private string? userName;
    private string? employeeName;
    private string? employeeNumber;
    [Inject] private IEmployee repoemployee { get; set; } = null!;
    [Inject] private IBeneficiario repobenefi { get; set; } = null!;
    [Inject] private IUsuario repousuario { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isMobile = await jsRuntime.InvokeAsync<bool>("isMobileDevice");
            if (!string.IsNullOrEmpty(userEmail))
            {
                await repoemployee.UpdateDispositivoAsync(userEmail, isMobile);
                StateHasChanged();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            userEmail = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value;
            string nombre = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.GivenName)?.Value;
            string apellido = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Surname)?.Value;

            userName = CultureInfo.CurrentCulture.TextInfo.ToTitleCase($"{nombre}, {apellido}".ToLower());

            await LoadUserDataAsync();
            await LoadAdminDataAsync();
        }
        catch (Exception ex)
        {
            // Manejo de errores (opcional)
            Console.WriteLine($"Error al cargar datos del usuario: {ex.Message}");
        }
        cargando = false;
    }

    private async Task LoadUserDataAsync()
    {
        // var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        // var user = authState.User;
        // userEmail = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value;
        // userName = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value;
        if (!string.IsNullOrEmpty(userEmail))
        {
            employee = await repoemployee.GetByEmailAsync(userEmail);
            if (employee != null)
            {
                existe = true;
                employeeName = CultureInfo.CurrentCulture.TextInfo.ToTitleCase(employee.FullName.ToLower());

                string[] cadena = employeeName.Split(',');
                if(cadena.Length > 1)
                    employeeName = $"{cadena[1]}, {cadena[0]}";

                employeeNumber = employee.EmployeeNumber.ToString();

                beneficiario = await repobenefi.GetByEmployeeEmailAsync(employee.Email);
            }
        }
        await Task.CompletedTask;
    }

    private async Task LoadAdminDataAsync()
    {
        if (!string.IsNullOrEmpty(userEmail))
        {
            usuario = await repousuario.GetByEmailAsync(userEmail);
            if (usuario != null)
            {
                existeAdminUser = true;
            }
        }
        await Task.CompletedTask;
    }

    private void EditarEntidad(Beneficiario ben)
    {
        // if (ben.Documento1 == null)
        //     NavManager.NavigateTo($"/documento1/{ben.Id}");
        // else if (ben.Documento2 == null)
        //     NavManager.NavigateTo($"/documento2/{ben.Id}");
        // else if (ben.Documento3 == null)
        //     NavManager.NavigateTo($"/documento3/{ben.Id}");
        // else
        if(ben.EstadoPostulacion is not null)
            return;
        
        NavManager.NavigateTo($"/editar/{ben.Id}");
    }

    private void Salir()
    {
        NavManager.NavigateTo($"/Saml2/Logout");
    }
}