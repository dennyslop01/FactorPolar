@rendermode InteractiveServer
@inject GoogleDriveService DriveService

<label for="fileVideo" class="btn btn-primary" style="cursor:pointer;">
    <i class="bi bi-upload"></i> Subir Video
</label>
<InputFile id="fileVideo" OnChange="UploadFileVideo" accept="video/*" style="display:none;" />
<br />
<br />

@if (fileNames.Any())
{
    <div>
        @foreach (var name in fileNames)
        {
            <strong>
                <label class="form-label">
                    <i class="bi bi-camera-video"></i> @name
                </label>
            </strong>
        }
    </div>
}
<br />
<br />
@if (mostrarAlerta)
{
    <div id="divAlertavideo" class="alert alert-success alert-dismissible fade show toast-container" role="alert" style="display:none;">
        @mensajeAlerta
    </div>
}
else
{
    <div id="divAlertavideo" class="alert alert-success alert-dismissible fade show toast-container" role="alert" style="display:none;">
    </div>
}

@if (cargando)
{
    <div class="modal fade show d-block modal-loading-center" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <!-- 'modal-dialog-centered' centra el modal verticalmente -->
        <div class="modal-dialog modal-dialog-centered">
            <!-- Ajustamos el ancho con 'mx-auto' y eliminamos bordes/fondo si solo quieres ver el spinner -->
            <div class="modal-content" style="background: transparent; border: none;">
                <div class="modal-body text-center">
                    <div class="modal-cargando">
                        <!-- Spinner de Bootstrap -->
                        <div class="spinner-border text-light" style="width: 3rem; height: 3rem;" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        @* <p class="text-light mt-2">Cargando...</p> *@
                        <MudStack Spacing="2">
                            <MudText Align="Align.Center" Typo="Typo.h6">
                                Subiendo... @progressPercent%
                            </MudText>

                            <!-- La Barra de Progreso Controlada -->
                            <MudProgressLinear Color="Color.Success"
                                               Value="@progressPercent"
                                               Size="Size.Large"
                                               Striped="true"
                                               Class="my-2" />

                            <MudText Align="Align.Center" Typo="Typo.caption" Color="Color.Warning">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" />
                                Por favor no cierres esta pantalla ni apagues la pantalla.
                            </MudText>
                        </MudStack>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

