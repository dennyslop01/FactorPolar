@using System.Globalization
@rendermode InteractiveServer

<div class="container mt-4 pb-5">
    <!-- CABECERA PRINCIPAL -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white shadow-sm rounded-3">
        <div>
            <h6 class="text-muted mb-0">Evaluación En Vivo Participante</h6>
            @if (beneficiario != null)
            {    
                <h6 class="fw-bold text-primary mb-0">@datosbenefi</h6>
            }
        </div>
    </div>
    @if (beneficiario != null)
    {
        <div class="row">
             <!-- COLUMNA DERECHA: DOCUMENTOS Y MULTIMEDIA -->
            <div class="col-lg-12">
                <!-- Tarjeta PDF -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white py-3">
                        <h6 class="mb-0"><i class="bi bi-mortarboard-fill me-2"></i>Rubrica a Evaluar</h6>
                    </div>
                    <br />

                    <div class="text-end me-4">
                        <!-- Badge más grande con fuente prominente -->
                        <span class="badge bg-secondary rounded-pill px-4 py-2 shadow-sm"
                              style="font-size: 1rem; font-weight: 600; min-width: 70px;">
                            @puntuacionGral
                        </span>
                    </div>

                    <div class="card-body">
                        <EditForm EditContext="editContext" OnValidSubmit="GuardarIniEvaluacion">
                            <div class="row">
                                @foreach (var grupo in entidadActual.GroupBy(x => x.IdGrupo).Select(g => g.First()))
                                {
                                    <div class="col-md-4 mb-4" style="border-right: 1px solid #eee;">
                                        <strong><h6 class="mb-3">@grupo.DescGrupo</h6></strong>

                                        @foreach (var item in entidadActual.Where(x => x.IdGrupo == grupo.IdGrupo))
                                        {
                                            // Creamos el identificador para este item específico
                                            var fieldId = new FieldIdentifier(item, nameof(item.Codigo));
                                            var tieneError = editContext.GetValidationMessages(fieldId).Any();

                                            <div class="mb-4">
                                                <label class="text-muted small fw-bold text-uppercase d-block">@item.Descripcion</label>

                                                <MudRating SelectedValue="@item.Codigo"
                                                           SelectedValueChanged="@((int val) => OnRatingChanged(item, val))"
                                                           Color="Color.Warning"
                                                           Size="Size.Medium"
                                                           FullIcon="@Icons.Material.Filled.Star"
                                                           EmptyIcon="@Icons.Material.Outlined.StarBorder" />
                                                <ValidationMessage For="@(() => item.Codigo)" />
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="d-flex justify-content-center gap-2">
                                <button type="button" @onclick="AbrirConfirmacionGuardar" class="btn btn-outline-primary btn-sm rounded-pill px-4">
                                    Guardar
                                </button>

                                @if (editarEntidad && Listgral.Count()>0)
                                {
                                    <button type="button" @onclick="CancelarGuardar" class="btn btn-outline-danger btn-sm rounded-pill px-4">
                                        Cancelar
                                    </button>
                                }
                            </div>

                        </EditForm>
                        <hr />

                        @if (mostrarModalGuardar)
                        {
                            <div class="modal-overlay">
                                <div class="modal-container">
                                    <div class="modal-body">
                                        <h2>¿Guardar Evaluación?</h2>
                                        <p>Se registrarán los puntajes asignados al talento <strong>@datosbenefi</strong>. ¿Deseas continuar?</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button class="btn-cancel" @onclick="() => mostrarModalGuardar = false">Revisar</button>
                                        <button class="btn-confirm" @onclick="ConfirmarGuardado">Sí, guardar</button>
                                    </div>
                                </div>
                            </div>
                        }
 
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@if(!editarEntidad)
{
    <div class="card shadow-sm border-0 h-auto">
        <div class="card-header bg-white py-3">
            <div class="d-flex align-items-center">
                <div class="bg-primary p-2 rounded-3 me-3">
                    <i class="bi bi-people-fill text-white fs-4"></i>
                </div>
                <h6 class="mb-0 fw-bold text-secondary">Talentos Clasificados - Presentación en Vivo</h6>
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-4">
                    <div>
                        <strong>Nro. de Registros:</strong> @Listgral.Count()
                    </div>
                </div>
            </div>
            <hr />
            <div class="table-responsive">
                <PaginationComponent TItem="BeneficiarioEnVivo" Items="Listgral" DefaultPageSize="10">
                    <ChildContentHeader>
                        <tr class="table-light">
                            @* <th class="border-0 text-uppercase small fw-bold">#</th> *@
                            <th class="border-0 text-uppercase small fw-bold">No. Pers</th>
                            <th class="border-0 text-uppercase small fw-bold">Nombre del Empleado</th>
                            <th class="border-0 text-uppercase small fw-bold">Nombre del Beneficiario</th>
                            <th class="border-0 text-uppercase small fw-bold">Fecha Nacimiento</th>
                            <th class="border-0 text-uppercase small fw-bold text-center">Edad</th>
                            <th class="border-0 text-uppercase small fw-bold text-center">Puntaje</th>
                            <th class="border-0 text-uppercase small fw-bold text-center">Categoría</th>
                            <th class="border-0 text-end">Acciones</th>
                        </tr>
                    </ChildContentHeader>
                    <ChildContentRow Context="p">
                        <tr class="align-middle">
                            @* <td><span class="text-muted">@p.Id</span></td> *@
                            <td class="fw-bold text-primary">@p.Employee.EmployeeNumber</td>
                            <td>@CultureInfo.CurrentCulture.TextInfo.ToTitleCase(p.Employee.FullName.ToLower())</td>
                            <td>@CultureInfo.CurrentCulture.TextInfo.ToTitleCase(p.FullName.ToLower())</td>
                            <td>@p.FechaNacimiento.ToShortDateString()</td>
                            <td class="text-center">
                                <span class="badge bg-info-subtle text-info border border-info-subtle px-4 py-2 rounded-pill">
                                    @p.Edad años
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info-subtle text-info border border-info-subtle px-4 py-2 rounded-pill fs-6 fw-bold">
                                    @($"{p.Puntaje:0.00}")
                                </span>
                            </td>
                            <td>@p.Categoria</td>
                            <td class="text-end">
                                <button class="btn btn-outline-warning btn-sm border-2 fw-bold px-3 rounded-pill"
                                        @onclick="() => ActivarEnVivo(p)">
                                    @* <i class="bi bi-search me-1"></i> *@ Editar
                                </button>
                            </td>
                        </tr>
                    </ChildContentRow>
                </PaginationComponent>
            </div>
        </div>
    </div>
}
<br />

@if (mostrarAlerta)
{
    <div id="divAlerta" class="alert alert-success alert-dismissible fade show toast-container" role="alert" style="display:none;">
        @mensajeAlerta
        <button type="button" class="btn-close" @onclick="() => mostrarAlerta = false"></button>
    </div>
}


@if (cargando)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); align-content:center">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="modal-cargando text-lg-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


@code {
    string datosbenefi = string.Empty;
    private Beneficiario? beneficiario = new();
    private const string notaprimaria = "A";

    private string? mensajeAlerta;
    private bool mostrarAlerta = false;

    private List<RubricaCompuesta> entidadActual = new();
    private EditContext? editContext;
    private ValidationMessageStore? mensajeStore;

    private bool cargando = false;

    private List<RubricaEvaluacion> rubricatodas = new();
    private List<RubricaEvaluacion> rubricainicial = new();
    private List<BeneficiarioRubricaEnVivo?> benefirubricauser = new();
    private List<BeneficiarioEnVivo> Listgral = new();

    private int userRolgral = 0;
    private decimal puntuacionGral = 0;
    private bool editarEntidad = false;

    [Inject] private IBeneficiario repobenefi { get; set; } = null!;
    [Inject] private IRubricaEvaluacion reporubrica { get; set; } = null!;
    [Inject] private IBeneficiarioRubricaEnVivo reporubbenefi { get; set; } = null!;
    [Inject] private IBeneficiarioClasificado reporubbeneficla { get; set; } = null!;

    private bool mostrarModalGuardar = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            cargando = true;
            StateHasChanged();
            await jsRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 10);

            cargando = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await authStateProvider.GetAuthenticationStateAsync();
            if (!authState.User.Identity.IsAuthenticated)
                NavManager.NavigateTo($"/");
        }
        catch
        {
            NavManager.NavigateTo($"/");
        }

        cargando = true;
        try
        {
            editContext = new EditContext(entidadActual);
            mensajeStore = new ValidationMessageStore(editContext);
            editContext.OnFieldChanged += (s, e) => mensajeStore.Clear(e.FieldIdentifier);

            await LoadBenefiDataAsync();
        }
        catch (Exception ex)
        {
            datosbenefi = $"Error al cargar datos del beneficiario: {ex.Message}";
        }
        cargando = false;
    }

    private async Task LoadBenefiDataAsync()
    {
        var beneficiriosEval = await reporubbeneficla.GetAlllAsync();
        var existeactiva = beneficiriosEval.Where(x => x.Estado == 1).ToList();
        if (existeactiva.Count() > 0)
        {

            foreach (var ben in existeactiva)
            {
                beneficiario = await repobenefi.GetByIdlAsync(ben.Beneficiario.Id);
            }

            if (beneficiario != null)
            {
                datosbenefi = $"{CultureInfo.CurrentCulture.TextInfo.ToTitleCase($"{beneficiario.FullName}".ToLower())}, Edad: {beneficiario.Edad}";
            }
            rubricatodas = await reporubrica.GetAllAsync();

            await CompletarRubrica(beneficiario.Id);

            editarEntidad = true;
            if (benefirubricauser.Count() > 0)
            {
                beneficiario = null;
                editarEntidad = false;
            }
        }

        if (beneficiario == null)
            await LoadBenefiDataListaAsync();

        await Task.CompletedTask;
    }

    private async Task LoadBenefiDataListaAsync()
    {
        var beneficiriosEval = await reporubbenefi.GetAlllAsync();

        Listgral.Clear();

        var userid = await SessionStorage.GetAsync<string>("UserId");
        if (!string.IsNullOrEmpty(userid.Value))
        {
            // Obtenemos la fecha de hoy (solo fecha, sin hora para comparar correctamente)
            DateTime hoy = DateTime.Today;

            var existeactiva = beneficiriosEval
                .Where(x => x.Usuario.Id == int.Parse(userid.Value) &&
                            x.CreateDate.Date == hoy) // Filtramos por la fecha de hoy
                .ToList();

            if (existeactiva.Any())
            {
                var agrupados = existeactiva
                    .GroupBy(b => b.Beneficiario.Id)
                    .Select(g => new
                    {
                        Id = g.Key,
                        PuntajeTotal = g.Sum(x => x.FactorResultado)
                    });

                foreach (var grupo in agrupados)
                {
                    var beneficiario = await repobenefi.GetByIdlAsync(grupo.Id);

                    if (beneficiario != null)
                    {
                        Listgral.Add(new BeneficiarioEnVivo
                        {
                            Id = beneficiario.Id,
                            FullName = beneficiario.FullName,
                            FechaNacimiento = beneficiario.FechaNacimiento,
                            Employee = beneficiario.Employee,
                            Edad = beneficiario.Edad,
                            Puntaje = grupo.PuntajeTotal
                        });
                    }
                }
            }

        }
        await Task.CompletedTask;
    }

    private async Task CompletarRubrica(int Id)
    {
        entidadActual = new List<RubricaCompuesta>();
        var userid = await SessionStorage.GetAsync<string>("UserId");
        if (string.IsNullOrEmpty(userid.Value))
        {
            mensajeAlerta = $"Error al cargar la evaluación: Usuario no identificado.";
            mostrarAlerta = true;
            return;
        }
        else
            benefirubricauser = await reporubbenefi.GetByIdUserBenefilAsync(int.Parse(userid.Value), Id);

        for (int i = 6; i <= 8; i++)
        {
            rubricainicial = rubricatodas.Where(x => x.GrupoEvaluacion.Id == i).ToList();

            foreach (var r in rubricainicial)
            {
                var registro = new RubricaCompuesta
                {
                    IdRubrica = r.Id,
                    Descripcion = r.Descripcion,
                    IdGrupo = r.GrupoEvaluacion.Id,
                    DescGrupo = r.GrupoEvaluacion.NombreGrupo,
                    Codigo = (benefirubricauser.Count() > 0 ? benefirubricauser.Where(x => x.RubricaEvaluacion.Id == r.Id).Select(y => y.Puntuacion).First(): 0)
                };

                entidadActual.Add(registro);
            }
        }

        if(benefirubricauser.Count()>0)
        {
            puntuacionGral = 0;
            foreach (RubricaCompuesta rubrica in entidadActual)
            {
                decimal factor = rubricatodas.Where(x => x.Id == rubrica.IdRubrica).Select(y => y.Factor).First();
                puntuacionGral += rubrica.Codigo * factor;
            }
        }

    }

    private void OnRatingChanged(RubricaCompuesta item, int newValue)
    {
        // 1. Actualizamos el valor manualmente
        item.Codigo = newValue;

        // 2. Notificamos al EditContext que este campo específico cambió
        // Esto disparará la validación solo para este item y borrará el error rojo
        if (editContext != null)
        {
            var fieldId = new FieldIdentifier(item, nameof(item.Codigo));
            editContext.NotifyFieldChanged(fieldId);
        }

        puntuacionGral = 0;
        foreach(RubricaCompuesta rubrica in entidadActual)
        {
            decimal factor = rubricatodas.Where(x => x.Id == rubrica.IdRubrica).Select(y => y.Factor).First();
            puntuacionGral += rubrica.Codigo * factor;
        }
    }

    private async Task GuardarIniEvaluacion()
    {
        try
        {
            mensajeStore?.Clear(); // Limpiar errores previos

            bool hayErrores = false;

            foreach (var item in entidadActual)
            {
                if (item.Codigo == 0)
                {
                    // Asociamos el error específicamente a la propiedad Codigo de ESTE item
                    var fieldIdentifier = new FieldIdentifier(item, nameof(item.Codigo));
                    mensajeStore?.Add(fieldIdentifier, "Este campo es obligatorio.");
                    hayErrores = true;
                }
            }

            if (hayErrores)
            {
                editContext?.NotifyValidationStateChanged(); // Esto "refresca" la UI y muestra los mensajes
                return;
            }

            var userid = await SessionStorage.GetAsync<string>("UserId");
            if (!string.IsNullOrEmpty(userid.Value))
            {
                try
                {
                    foreach (var item in entidadActual)
                    {
                        await reporubbenefi.CreateAsync(int.Parse(userid.Value), item.IdRubrica, beneficiario.Id, item.Codigo);
                    }
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    mensajeAlerta = $"Error al guardar la evaluación: {ex.Message}";
                    mostrarAlerta = true;
                }
            }

            editarEntidad = false;
            await LoadBenefiDataAsync();
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al guardar la evaluación: {ex.Message}";
            mostrarAlerta = true;
        }
    }

    private void AbrirConfirmacionGuardar()
    {
        // Opcional: Podrías validar el editContext aquí antes de mostrar el modal
        if (editContext.Validate())
        {
            mostrarModalGuardar = true;
        }
    }

    private async Task ConfirmarGuardado()
    {
        mostrarModalGuardar = false;
        cargando = true; // Mostramos tu spinner de carga

        // Llamas a tu lógica original de guardado
        await GuardarIniEvaluacion();

        cargando = false;
    }

    private async Task ActivarEnVivo(BeneficiarioEnVivo ben)
    {
        var userid = await SessionStorage.GetAsync<string>("UserId");
        if (!string.IsNullOrEmpty(userid.Value))
        {
            benefirubricauser = await reporubbenefi.GetByIdUserBenefilAsync(int.Parse(userid.Value), ben.Id);
            beneficiario = await repobenefi.GetByIdlAsync(ben.Id);
            await CompletarRubrica(ben.Id);
            editarEntidad = true;
        }
    }

    private async Task CancelarGuardar()
    {
        editarEntidad = false;
        await LoadBenefiDataAsync();
    }
}