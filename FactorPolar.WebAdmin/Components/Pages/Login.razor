@page "/login"
@rendermode InteractiveServer

@* <button class="btn btn-primary" @onclick="LoginAsync">Login con Google</button> *@

@code {
    [Inject] private IGoogleAuthorization googleAuthorization { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoginAsync();
        }
        catch (Exception ex)
        {
            // Manejo de errores (opcional)
            Console.WriteLine($"Error al cargar datos del usuario: {ex.Message}");
        }
    }

    private async Task LoginAsync()
    {
        // var client = httpClientFactory.CreateClient(Constant.Client);
        // var result = await client.GetAsync("/autorize");
        // if(result.IsSuccessStatusCode)
        // {
        //     NavManager.NavigateTo(await result.Content.ReadAsStringAsync());
        // }

        string result = googleAuthorization.GetGoogleAuthorizationUrl();
        if (!string.IsNullOrEmpty(result))
        {
            NavManager.NavigateTo(result);
        }
    }
}
