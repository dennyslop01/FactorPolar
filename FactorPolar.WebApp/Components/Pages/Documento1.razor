@page "/documento1/{Id}"
@rendermode InteractiveServer

<h5>Documento 1</h5>

<p>@datosbenefi</p>

<p>Lea detenidamente el documento hata el final y escriba la palabra "Acepto" para acepyar terminos y condiciones</p>

@if (!string.IsNullOrEmpty(pdfBase64String))
{
    <iframe id="pdfFrame" style="width:100%; height:500px;" frameborder="0"></iframe>
}
else
{
    <p>Cargando PDF o error al encontrar el archivo...</p>
}

<br />
<br />

<EditForm Model="@entidadActual" OnValidSubmit="GuardarDatos">
    <DataAnnotationsValidator />
    
    <div class="d-flex justify-content-center">
        <div class="mb-3">
            <label class="form-label">Escriba la palabra "Acepto"</label>
            <InputText class="form-control" @bind-Value="entidadActual.Acepto" maxlength="10" style="width: 90%;" />
            <ValidationMessage For="@(() => entidadActual.Acepto)" />
        </div>
    </div>
    <div class="d-flex justify-content-center">
        <button type="submit" class="btn btn-success me-2">
            <i class="bi bi-save"></i> Guardar
        </button>
    </div>

</EditForm>
@if (mostrarAlerta)
{
    <div id="divAlerta" class="alert alert-success alert-dismissible fade show toast-container" role="alert" style="display:none;">
        @mensajeAlerta
        <button type="button" class="btn-close" @onclick="() => mostrarAlerta = false"></button>
    </div>
}
<br />
<br />

@code {
    [Parameter]
    public string Id { get; set; }

    public class DocumentoModel
    {
        [Required(ErrorMessage = "Debe completar el campo.")]
        public string Acepto { get; set; } = string.Empty;
    }

    string datosbenefi = string.Empty;
    private Beneficiario? beneficiario = new();
    private string? mensajeAlerta;
    private bool mostrarAlerta = false;
    private DocumentoModel entidadActual = new();
    private string pdfBase64String;
    private string GetAssetPathWithHash() => "Documentos\\Documento1.wdhxwnve93.pdf";

    [Inject] private IBeneficiario repobenefi { get; set; } = null!;

    private async Task LoadAndConvertPdfToBase64Async()
    {
        var relativePathWithHash = GetAssetPathWithHash();

        // >>> ESTA ES LA MODIFICACIÓN CLAVE <<<
        // Elimina la parte del hash del nombre del archivo para encontrar el archivo físico real.
        // Asume que el hash está justo antes de la última extensión (.pdf)
        var physicalRelativePath = System.Text.RegularExpressions.Regex.Replace(
            relativePathWithHash,
            @"\.[a-zA-Z0-9]{8,}\.pdf$", // Busca un punto, 8+ caracteres alfanuméricos, y .pdf al final
            ".pdf"
        );

        // Construye la ruta física absoluta
        var physicalPath = Path.Combine(Env.WebRootPath, physicalRelativePath);

        // --- Depuración ---
        Console.WriteLine($"Ruta Web con hash: {relativePathWithHash}");
        Console.WriteLine($"Buscando ruta física: {physicalPath}");
        // ------------------

        if (System.IO.File.Exists(physicalPath))
        {
            // 1. Leer los bytes del archivo físico
            byte[] pdfBytes = await System.IO.File.ReadAllBytesAsync(physicalPath);

            // 2. Convertir el array de bytes a cadena Base64
            pdfBase64String = Convert.ToBase64String(pdfBytes);
        }
        else
        {
            Console.Error.WriteLine($"¡ERROR: Archivo físico no encontrado! Revise la ubicación o la expresión regular.");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            beneficiario = await repobenefi.GetByIdlAsync(int.Parse(Id));
            if (beneficiario != null)
            {
                datosbenefi = $"{beneficiario.CedulaIdentidad} - {beneficiario.FullName} - {beneficiario.Edad} años";
                await LoadAndConvertPdfToBase64Async();
            }
            entidadActual = new DocumentoModel();
        }
        catch (Exception ex)
        {
            datosbenefi = $"Error al cargar datos del beneficiario: {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(pdfBase64String))
        {
            await jsRuntime.InvokeVoidAsync("loadPdfFromBase64", pdfBase64String);
        }
    }

    private async Task GuardarDatos()
    {
        if (string.IsNullOrEmpty(entidadActual.Acepto) || entidadActual.Acepto.ToLower() != "acepto")
        {
            mensajeAlerta = "Debe escribir la palabra Acepto";
            mostrarAlerta = true;
            //await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
        }
        else
        {
            try
            {
                await repobenefi.UpdateAsync(int.Parse(Id), 1);
                mensajeAlerta = "Datos guardados correctamente.";
                mostrarAlerta = true;
                //await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
                NavManager.NavigateTo($"/documento2/{Id}");
            }
            catch (Exception ex)
            {
                mensajeAlerta = $"Error al guardar los datos: {ex.Message}";
                mostrarAlerta = true;
                //await JSRuntime.InvokeVoidAsync("TimeoutHelper.showAndHide", "divAlerta", 8000);
            }
        }
    }
}

<script>
    document.addEventListener("keydown", function (e) {
        if (e.ctrlKey && (e.key === "p" || e.key === "P")) {
            e.preventDefault();
            alert("La impresión está deshabilitada.");
        }
    });
</script>