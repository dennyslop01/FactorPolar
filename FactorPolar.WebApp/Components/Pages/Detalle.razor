@page "/detalle/{Id}"
@using System.Globalization
@inject GoogleDriveService DriveService
@inject IJSRuntime jsRuntime
@rendermode InteractiveServer

<div class="container mt-4 pb-5">
    <!-- CABECERA PRINCIPAL -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white shadow-sm rounded-3">
        <div>
            <h6 class="text-muted mb-0">Detalle del Participante</h6>
            <h6 class="fw-bold text-primary mb-0">@datosbenefi</h6>
        </div>
    </div>
    @if (beneficiario != null)
    {
        <div class="row g-4">
            <!-- COLUMNA IZQUIERDA: DATOS ACADÉMICOS -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-primary text-white py-3">
                        <h6 class="mb-0"><i class="bi bi-mortarboard-fill me-2"></i>Información Académica</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-4">
                            <label class="text-muted small fw-bold text-uppercase d-block">Tipo de Institución</label>
                            <span>@(beneficiario.TipoInstitucionAux ?? beneficiario.TipoInstitucion)</span>
                        </div>

                        <div class="mb-4">
                            <label class="text-muted small fw-bold text-uppercase d-block">Institución Educativa</label>
                            <span>@(beneficiario.NombreInstitucionAux ?? beneficiario.NombreInstitucion)</span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-6">
                                <label class="text-muted small fw-bold text-uppercase d-block">RIF</label>
                                <span>@(beneficiario.RifInstitucionAux ?? beneficiario.RifInstitucion)</span>
                            </div>
                            <div class="col-6">
                                <label class="text-muted small fw-bold text-uppercase d-block">Promedio</label>
                                <span class="badge bg-success fs-6 rounded-pill px-3">
                                    @(beneficiario?.NivelEducativo == "PRIMARIA" ? (beneficiario.Promedio != null ? notaprimaria : "-") : beneficiario?.Promedio)
                                </span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="text-muted small fw-bold text-uppercase d-block">Nivel Educativo</label>
                            <span>@(beneficiario.NivelEducativoAux ?? beneficiario.NivelEducativo)</span>
                        </div>

                        <div class="mb-0">
                            <label class="text-muted small fw-bold text-uppercase d-block">Nivel Académico</label>
                            <span>
                                @if (beneficiario?.NivelEducativo == "PRIMARIA")
                                {
                                    if (beneficiario.Promedio != null)
                                    {
                                        @notaprimaria
                                    }
                                }
                                else
                                {
                                    @beneficiario?.Promedio
                                }
                            </span>
                        </div>
                        <div class="mb-4">
                        </div>

                        <div class="mb-4">
                            @if (sinevaluar)
                            {
                                <button class="btn btn-outline-primary btn-sm rounded-pill px-4" @onclick="IniciarEvaluacion">
                                    Iniciar Evaluación
                                </button>
                            }
                            @if (rubricaevaluar)
                            {
                                <button class="btn btn-outline-primary btn-sm rounded-pill px-4" @onclick="CompletarRubrica">
                                    Completar Rúbrica
                                </button>
                            }
                            @if (vervaluar)
                            {
                                <button class="btn btn-outline-primary btn-sm rounded-pill px-4" @onclick="VerEvaluacion">
                                    Ver Evaluación
                                </button>
                            }
                            &nbsp; &nbsp;
                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-4" @onclick="Regresar">
                                <i class="bi bi-arrow-left-circle me-2"></i>Regresar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <!-- COLUMNA DERECHA: DOCUMENTOS Y MULTIMEDIA -->
            <div class="col-lg-8">
                <!-- Tarjeta PDF -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                        <h6 class="mb-0 fw-bold text-secondary"><i class="bi bi-file-earmark-pdf-fill me-2 text-danger"></i>Constancia de Notas</h6>
                    </div>
                    <div class="card-body p-0 bg-light">
                        <iframe id="pdfFrame" style="width:100%; height:450px; border:none;" frameborder="0"></iframe>
                    </div>
                </div>

                <!-- Tarjeta Video -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-bold text-secondary"><i class="bi bi-play-btn-fill me-2 text-warning"></i>Video del Talento</h6>
                    </div>
                    <div class="card-body p-0 bg-dark rounded-bottom overflow-hidden">
                        @if (!string.IsNullOrEmpty(videoSrc))
                        {
                            <video width="100%" height="450" controls style="outline: none;">
                                <source src="@videoSrc" type="video/mp4">
                                Tu navegador no soporta la reproducción de videos.
                            </video>
                        }
                        else
                        {
                            <div class="p-5 text-center text-white opacity-50">
                                <i class="bi bi-camera-video-off fs-1"></i>
                                <p class="mt-2">Cargando video o no disponible...</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<br />

@if (mostrarAlerta)
{
    <div id="divAlerta" class="alert alert-success alert-dismissible fade show toast-container" role="alert" style="display:none;">
        @mensajeAlerta
        <button type="button" class="btn-close" @onclick="() => mostrarAlerta = false"></button>
    </div>
}

@if (cargando)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); align-content:center">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="modal-cargando text-lg-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if(inieval)
{
    <br />
    <br />
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Criterio de entrada Fase I</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm EditContext="editContext" OnValidSubmit="GuardarIniEvaluacion">
                        <div class="mb-3">
                            @foreach (var item in entidadActual)
                            {
                                // Creamos el identificador para este item específico
                                var fieldId = new FieldIdentifier(item, nameof(item.Codigo));
                                var tieneError = editContext.GetValidationMessages(fieldId).Any();

                                <div class="mb-4">
                                    <label class="text-muted small fw-bold text-uppercase d-block">@item.Descripcion</label>

                                    <InputSelect @bind-Value="item.Codigo"
                                                 class="@(tieneError ? "form-select is-invalid" : "form-select")">
                                        <option value="">-- Seleccione uno --</option>
                                        <option value="1">Si</option>
                                        <option value="2">No</option>
                                    </InputSelect>

                                    @* Esto ahora sí mostrará el mensaje que agregamos en el C# *@
                                    <ValidationMessage For="@(() => item.Codigo)" />
                                </div>
                            }
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-4" >
                                Guardar
                            </button>&nbsp;&nbsp;&nbsp;
                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-4" @onclick="CerrarModal">
                                Cancelar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (compevaluar)
{
    <br />
    <br />
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Completar Rúbrica Fase II</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm EditContext="editContext" OnValidSubmit="GuardarCompEvaluacion">
                        <div class="mb-3">
                            @* @foreach (var item in entidadActual)
                            {
                                // Creamos el identificador para este item específico
                                var fieldId = new FieldIdentifier(item, nameof(item.Codigo));
                                var tieneError = editContext.GetValidationMessages(fieldId).Any();

                                <div class="mb-4">
                                    <label class="text-muted small fw-bold text-uppercase d-block">@item.Descripcion</label>

                                    <InputSelect @bind-Value="item.Codigo"
                                                 class="@(tieneError ? "form-select is-invalid" : "form-select")">
                                        <option value="">-- Seleccione uno --</option>
                                        <option value="1">Si</option>
                                        <option value="2">No</option>
                                    </InputSelect>

                                    <ValidationMessage For="@(() => item.Codigo)" />
                                </div>
                            } *@
                        </div>
                        <div class="d-flex justify-content-end">
                            @* <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-4">
                                Guardar
                            </button>&nbsp;&nbsp;&nbsp; *@
                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-4" @onclick="CerrarModal">
                                Cancelar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
