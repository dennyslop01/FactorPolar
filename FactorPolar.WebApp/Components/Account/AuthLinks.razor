@rendermode @(new InteractiveServerRenderMode(false))

<MudContainer>
    <AuthorizeView>
        <Authorized>
                <MudStack Row="true" Spacing="2" Justify="Justify.Center" AlignItems="AlignItems.Center">
                    @* <a Href="/"><MudImage Src="LogoPolar.png" Alt="Empresas Polar" Elevation="25" Class="rounded-lg" /></a> *@
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="EditUser"
                           Style="background-color: rgba(255,255,255,0.2); color: white;">
                    <MudIcon Icon="@Icons.Material.Filled.PersonPin" />Perfil
                </MudButton>
                <MudButton @onclick="LogoutAsync" Variant="Variant.Filled" Color="Color.Error"
                               Style="background-color: rgba(255,255,255,0.2); color: white;">
                    <MudIcon Icon="@Icons.Material.Filled.ExitToApp" />
                    </MudButton>
                </MudStack>
        </Authorized>
        <NotAuthorized>
            <MudStack Row="true" Spacing="2" Justify="Justify.Center" AlignItems="AlignItems.Center">
                @* <a Href="/"><MudImage Src="LogoPolar.png" Alt="Empresas Polar" Elevation="25" Class="rounded-lg" /></a> *@
                <MudButton Href="login" Variant="Variant.Filled" Color="Color.Error"
                           Style="background-color: rgba(255,255,255,0.2); color: white;">
                    <MudIcon Icon="@Icons.Material.Filled.Login" />
                </MudButton>
            </MudStack>
        </NotAuthorized>
    </AuthorizeView>
</MudContainer>

@code {
    [Inject] private ICredentialRepository repository { get; set; } = null!;

    async Task LogoutAsync()
    {
        try
        {
            var token = await localStorageService.GetItemAsStringAsync(Constant.Key);
            if (!string.IsNullOrEmpty(token))
            {
                var tokenModel = JsonSerializer.Deserialize<Token>(token);
                await repository.DeleteCredential(tokenModel.AccessToken);
            }
            await localStorageService.DeleteItemAsync(Constant.Key);
        }
        catch { }
        NavManager.NavigateTo("/", true);
    }
}