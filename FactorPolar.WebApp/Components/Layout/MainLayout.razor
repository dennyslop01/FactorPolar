@inherits LayoutComponentBase
@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

<MudLayout>
    <MudAppBar Elevation="2" Style="background: linear-gradient(135deg, #144e77  0%, #144e77  100%);">
        <a href="/"><MudImage Src="LogoPolar.png" Alt="Empresas Polar" Elevation="25" Class="rounded-lg" /></a>
        <MudText Typo="Typo.h4" Style="color: white;"></MudText>
        <MudSpacer />
        <MudText Typo="Typo.body1" Style="color: white; margin-right: 16px;">
            <AuthLinks />
        </MudText>
    </MudAppBar>
    @* Needed for snackbars *@
    <MudSnackbarProvider />

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Style="margin-top: 3rem">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = false;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}
<style>
    body, .table, .input,
    .button, .icon {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 11px;
    }

    .modal-container {
        /* Ocupa toda la ventana gráfica */
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5); /* Fondo oscuro semitransparente */
        /* Centrado con Flexbox */
        display: flex;
        justify-content: center; /* Centrado horizontal */
        align-items: center; /* Centrado vertical */
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 11px;
    }

    .modal-content {
        /* Estilos para el cuadro del modal */
        background-color: white;
        padding: 20px;
        border-radius: 5px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        /* Opcional: define un ancho máximo */
        max-width: 500px;
        width: 90%;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 11px;
    }
</style>

