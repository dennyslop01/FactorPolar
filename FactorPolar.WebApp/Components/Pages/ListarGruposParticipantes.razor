@code{
    private List<Beneficiario> Listgral = new();
    private List<Beneficiario> ListgralBuscar = new();
    private List<Beneficiario> List1 = new();
    private List<Beneficiario> List2 = new();
    private List<Beneficiario> List3 = new();
    private List<Beneficiario> List4 = new();

    private List<BeneficiarioRubrica?> benefirubricauser = new();
    private List<Beneficiario> ListEvalgral = new();
    private List<Beneficiario> ListEvalgralBuscar = new();
    private List<Beneficiario> ListEval1 = new();
    private List<Beneficiario> ListEval2 = new();
    private List<Beneficiario> ListEval3 = new();
    private List<Beneficiario> ListEval4 = new();

    private bool mostrarFormulario = false;
    private bool mostrarFormulario2 = false;
    private string searchTerm = "";
    private bool evalpendiente = false;
    private string nombrePendiente = string.Empty;
    private int userRolgral = 0;

    private DatosCSV entidadActual = new();

    [Inject] private IBeneficiario repobenefi { get; set; } = null!;
    [Inject] private IBeneficiarioRubrica reporubbenefi { get; set; } = null!;

    // Estructura para simplificar el renderizado de los tabs
    private List<GrupoInfo> GruposConfig = new()
    {
        new GrupoInfo { Id = 1, Nombre = "Grupo 1", Rango = "6 a 8 años" },
        new GrupoInfo { Id = 2, Nombre = "Grupo 2", Rango = "9 a 11 años" },
        new GrupoInfo { Id = 3, Nombre = "Grupo 3", Rango = "12 a 14 años" },
        new GrupoInfo { Id = 4, Nombre = "Grupo 4", Rango = "15 a 17 años" }
    };

    private List<Beneficiario> GetListById(int id) => id switch
    {
        1 => List1,
        2 => List2,
        3 => List3,
        4 => List4,
        _ => new List<Beneficiario>()
    };

    private List<Beneficiario> GetListEvalById(int id) => id switch
    {
        1 => ListEval1,
        2 => ListEval2,
        3 => ListEval3,
        4 => ListEval4,
        _ => new List<Beneficiario>()
    };

    public class GrupoInfo { public int Id { get; set; } public string Nombre { get; set; } public string Rango { get; set; } }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadBenefiDataAsync();

            var userrol = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrol.Value))
            {
                userRolgral = int.Parse(userrol.Value);
            }
        }
        catch (Exception ex)
        {
            // Manejo de errores (opcional)
            Console.WriteLine($"Error al cargar datos del los beneficiarios: {ex.Message}");
        }
    }

    private async Task LoadBenefiDataAsync()
    {
        Listgral = await repobenefi.GetByParticipantesAsync();
        ListgralBuscar = Listgral; // Guardamos la lista original para futuras búsquedas

        if (Listgral != null)
        {
            var userid = await SessionStorage.GetAsync<string>("UserId");
            if (!string.IsNullOrEmpty(userid.Value))
            {
                benefirubricauser = await reporubbenefi.GetByIdUserlAsync(int.Parse(userid.Value));
                if (benefirubricauser.Count > 0)
                {
                    ListEvalgral = Listgral.Where(b => benefirubricauser.Any(br => br.Beneficiario.Id == b.Id)).ToList();
                    ListEvalgralBuscar = ListEvalgral; // Guardamos la lista original de evaluados para futuras búsquedas

                    Listgral = Listgral.Where(b => !benefirubricauser.Any(br => br.Beneficiario.Id == b.Id)).ToList();
                    ListgralBuscar = Listgral; // Guardamos la lista original para futuras búsquedas

                    ListEval1 = ListEvalgral.Where(b => b.Edad >= 6 && b.Edad <= 8).ToList();
                    ListEval2 = ListEvalgral.Where(b => b.Edad >= 9 && b.Edad <= 11).ToList();
                    ListEval3 = ListEvalgral.Where(b => b.Edad >= 12 && b.Edad <= 14).ToList();
                    ListEval4 = ListEvalgral.Where(b => b.Edad >= 15 && b.Edad <= 17).ToList();

                    var evalp = benefirubricauser.Where(x => x.CloseDate == null &&
                                                                    x.Puntuacion == 1 && (x.RubricaEvaluacion.Id == 30 ||
                                                                    x.RubricaEvaluacion.Id == 31)).ToList();
                    nombrePendiente = string.Empty;
                    if (evalp.Count() > 0)
                    {
                        int idaux = 0;
                        foreach (var item in evalp.OrderBy(x => x.Beneficiario.Id).Distinct())
                        {
                            int puntaje = benefirubricauser.Where(y => y.Beneficiario.Id == item.Beneficiario.Id).Sum(x => x.Puntuacion);
                            if (puntaje >= 2)
                            {
                                if (!nombrePendiente.Contains(item.Beneficiario.FullName.ToString()))
                                    nombrePendiente += item.Beneficiario.FullName.ToString() + ", ";

                                evalpendiente = true;
                            }
                        }
                    }
                }
                List1 = Listgral.Where(b => b.Edad >= 6 && b.Edad <= 8).ToList();
                List2 = Listgral.Where(b => b.Edad >= 9 && b.Edad <= 11).ToList();
                List3 = Listgral.Where(b => b.Edad >= 12 && b.Edad <= 14).ToList();
                List4 = Listgral.Where(b => b.Edad >= 15 && b.Edad <= 17).ToList();
            }
            else
            {
                List1 = Listgral.Where(b => b.Edad >= 6 && b.Edad <= 8).ToList();
                List2 = Listgral.Where(b => b.Edad >= 9 && b.Edad <= 11).ToList();
                List3 = Listgral.Where(b => b.Edad >= 12 && b.Edad <= 14).ToList();
                List4 = Listgral.Where(b => b.Edad >= 15 && b.Edad <= 17).ToList();
            }
        }
        await Task.CompletedTask;
    }

    private async Task FiltrarBusqueda(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        if (string.IsNullOrEmpty(searchTerm))
        {
            await LoadBenefiDataAsync(); // Recargar datos completos si el término de búsqueda está vacío
        }
        else
        {
            var lowerSearchTerm = searchTerm.ToLower();
            Listgral = ListgralBuscar.Where(b => b.FullName.ToLower().Contains(lowerSearchTerm)).ToList();
            List1 = Listgral.Where(b => b.Edad >= 6 && b.Edad <= 8).ToList();
            List2 = Listgral.Where(b => b.Edad >= 9 && b.Edad <= 11).ToList();
            List3 = Listgral.Where(b => b.Edad >= 12 && b.Edad <= 14).ToList();
            List4 = Listgral.Where(b => b.Edad >= 15 && b.Edad <= 17).ToList();

            ListEvalgral = ListEvalgralBuscar.Where(b => b.FullName.ToLower().Contains(lowerSearchTerm)).ToList();
            ListEval1 = ListEvalgral.Where(b => b.Edad >= 6 && b.Edad <= 8).ToList();
            ListEval2 = ListEvalgral.Where(b => b.Edad >= 9 && b.Edad <= 11).ToList();
            ListEval3 = ListEvalgral.Where(b => b.Edad >= 12 && b.Edad <= 14).ToList();
            ListEval4 = ListEvalgral.Where(b => b.Edad >= 15 && b.Edad <= 17).ToList();
        }
        StateHasChanged();
    }

    private async Task VerDetalle(Beneficiario ben)
    {
        var userid = await SessionStorage.GetAsync<string>("UserId");
        if (!string.IsNullOrEmpty(userid.Value))
        {
            benefirubricauser = await reporubbenefi.GetByIdUserlAsync(int.Parse(userid.Value));

            var evalp = benefirubricauser.Where(x => x.CloseDate == null &&
                                                            x.Puntuacion == 1 && (x.RubricaEvaluacion.Id == 30 ||
                                                            x.RubricaEvaluacion.Id == 31)).ToList();
            nombrePendiente = string.Empty;
            if (evalp.Count() > 0)
            {
                int idaux = 0;
                foreach (var item in evalp.OrderBy(x => x.Beneficiario.Id))
                {
                    int puntaje = benefirubricauser.Where(y => y.Beneficiario.Id == item.Beneficiario.Id).Sum(x => x.Puntuacion);
                    if (puntaje>=2)
                    {
                        if (ben.Id != item.Beneficiario.Id)
                        {
                            nombrePendiente = item.Beneficiario.FullName.ToString();
                            evalpendiente = true;
                            return;
                        }
                    }
                }
            }
            NavManager.NavigateTo($"/detalle/{ben.Id}");
        }
    }

    private async Task DescargarDatos()
    {
        try
        {
            if (mostrarFormulario == false)
            {
                entidadActual = new DatosCSV();
                entidadActual.TipoSeparador = -1;
                mostrarFormulario = true;
            }
            else
            {
                string separador = string.Empty;

                switch (entidadActual.TipoSeparador)
                {
                    case 1:
                        separador = ",";
                        break;
                    case 2:
                        separador = ";";
                        break;
                    case 3:
                        separador = @"\t";
                        break;
                }

                await ExportarCsv(separador, 1);
                mostrarFormulario = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task DescargarDatos2()
    {
        try
        {
            if (mostrarFormulario2 == false)
            {
                entidadActual = new DatosCSV();
                entidadActual.TipoSeparador = -1;
                mostrarFormulario2 = true;
            }
            else
            {
                string separador = string.Empty;

                switch (entidadActual.TipoSeparador)
                {
                    case 1:
                        separador = ",";
                        break;
                    case 2:
                        separador = ";";
                        break;
                    case 3:
                        separador = @"\t";
                        break;
                }

                await ExportarCsv(separador, 2);
                mostrarFormulario2 = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        mostrarFormulario2 = false;
        evalpendiente = false;
    }

    private async Task ExportarCsv(string separador, int opcion)
    {
        try
        {
            var csvString = GenerarCsv(separador, opcion); // Implementa esta función para formatear los datos
            await jsRuntime.InvokeVoidAsync("downloadFileFromStream", ((opcion == 1) ? $"ListaBeneficiarios.csv" : $"ListaBeneficiariosEvaluados.csv"), csvString);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private string GenerarCsv(string separador, int opcion)
    {
        try
        {
            // Lógica para construir la cadena CSV
            var sb = new StringBuilder();

            int i = 0;
            string encabezado = string.Empty;
            encabezado += $"No. Pers{separador}Nombre del Beneficiario{separador}Fecha Nacimiento{separador}Edad";

            sb.AppendLine(encabezado); // Encabezados

            string linea = string.Empty;

            if(opcion == 1)
            {
                foreach (var p in Listgral)
                {
                    linea = $"{p.Employee.EmployeeNumber}{separador}{CultureInfo.CurrentCulture.TextInfo.ToTitleCase(p.FullName.ToLower())}{separador}{p.FechaNacimiento.ToShortDateString()}{separador}{p.Edad.ToString()}";
                    sb.AppendLine(linea); //Lineas
                }
            }
            else if (opcion == 2)
            {
                foreach (var p in ListEvalgral)
                {
                    linea = $"{p.Employee.EmployeeNumber}{separador}{CultureInfo.CurrentCulture.TextInfo.ToTitleCase(p.FullName.ToLower())}{separador}{p.FechaNacimiento.ToShortDateString()}{separador}{p.Edad.ToString()}";
                    sb.AppendLine(linea); //Lineas
                }

            }

            return sb.ToString();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        return null;
    }

    private async Task VerEvaluaciones(Beneficiario benefi)
    {
        var userid = await SessionStorage.GetAsync<string>("UserId");
        if (!string.IsNullOrEmpty(userid.Value))
        {
            var userrol = await SessionStorage.GetAsync<string>("UserRol");
            if (!string.IsNullOrEmpty(userrol.Value))
            {
                if (userrol.Value == "1")
                {
                    NavManager.NavigateTo($"/verevaluaciones/{benefi.Id}");
                }
            }
        }
    }
}

